// Icebreaker : ultimes du guerrier (jalon A, `docs/icebreaker/PLAN-CLASSES.md`). Un ultime appartient à la classe :
// il reste quel que soit le jeu d'armes en mains, n'a pas de niveau et se recharge longtemps (secondes).
// Format d'une compétence : voir `jeux_armes/grande_epee.ron`.
#![enable(implicit_some)]
(
    ultimes: [
        ("envol", (
            nom: "Envol",
            description: "Le guerrier s'élève, des ailes dorées dans le dos, et retombe sans dégâts de chute : l'impact blesse les ennemis autour et relève les alliés à terre.",
            capacite: "icebreaker.abilities.guerrier.ultimes.envol",
            icone: "common.abilities.axe.furor",
            recharge: 90.0,
        )),
        ("seisme", (
            nom: "Séisme",
            description: "Trois frappes au sol d'affilée : chacune lance devant le guerrier une secousse qui blesse et soulève.",
            capacite: "icebreaker.abilities.guerrier.ultimes.seisme",
            animation: "common.abilities.hammer.tremor",
            recharge: 60.0,
        )),
        ("rempart", (
            nom: "Rempart",
            description: "Dresse un cercle de pierres : le groupe qui s'y tient encaisse bien mieux, vingt secondes.",
            capacite: "common.abilities.hammer.rampart",
            recharge: 120.0,
        )),
    ],
)
