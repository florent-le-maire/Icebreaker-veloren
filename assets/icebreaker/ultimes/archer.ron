            capacite: "icebreaker.abilities.archer.ultimes.pluie_de_fleches",
            animation: "common.abilities.bow.fusillade",
            recharge: 75.0,
        )),
        ("oeil_d_aigle", (
            nom: "Œil d'aigle",
            description: "Vingt secondes de visée parfaite : les tirs frappent bien plus fort, partent plus vite, et l'endurance remonte.",
            capacite: "icebreaker.abilities.archer.ultimes.oeil_d_aigle",
            animation: "common.abilities.bow.eagle_eye",
