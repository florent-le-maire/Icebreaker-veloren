// Icebreaker : jeu d'armes « marteau à deux mains » du guerrier (jalon A). Format : voir `grande_epee.ron`.
#![enable(implicit_some)]
(
    nom: "Marteau à deux mains",
    classe: "guerrier",
    icone: "marteau",
    main_droite: (arme: Hammer, mains: Two),
    armes: ("common.items.weapons.hammer.starter_hammer", None),
    competences: [
        ("revers_meprisant", (
            nom: "Revers méprisant",
            description: "Un revers qui repousse et galvanise celui qui le porte.",
            capacite: "common.abilities.hammer.scornful_swipe",
            recharge: 8.0,
        )),
        ("moulinet", (
            nom: "Moulinet",
            description: "Un tour complet qui envoie valser tout ce qui est au contact.",
            capacite: "common.abilities.hammer.heavy_whorl",
            recharge: 8.0,
        )),
        ("interception", (
            nom: "Interception",
            description: "Une charge en avant qui percute et repousse.",
            capacite: "common.abilities.hammer.intercept",
            recharge: 10.0,
        )),
        ("tempete_de_fer", (
            nom: "Tempête de fer",
            description: "Le marteau tourne sans s'arrêter et frappe tout autour, jusqu'à huit fois.",
            capacite: "common.abilities.hammer.iron_tempest",
            recharge: 14.0,
        )),
    ],
)
