// Icebreaker : la forme des grottes (docs/icebreaker/PLAN-CAVERNE.md, jalon U). Chaque profil est un jeu de réglages
// du générateur (icebreaker-caverne) ; la graine d'une grotte en tire un selon les poids (ICEBREAKER_GROTTE_PROFIL
// pour en demander un). Les réglages absents gardent leur valeur par défaut (icebreaker-caverne/src/lib.rs,
// `forme!` : nom, défaut, bornes, libellé).
// Pour régler : `.\icebreaker.ps1 caverne` ouvre l'atelier ; « Copier les réglages » donne le bloc `forme` à coller ici.
(
    profils: {
        // Très vertical : des zones empilées, reliées par des puits où le sentier descend en lacets.
        "gouffre": (
            poids: 1.0,
            forme: (
                zones: 6.0, verticalite: 0.95, part_plaine: 0.3, profondeur: 280.0, emprise: 160.0, boucles: 0.0,
                plaine_rayon: 32.0, chaos_rayon: 26.0, chaos_hauteur: 44.0, puits_rayon: 16.0, puits_longueur: 40.0,
            ),
        ),
        // Très étalé : d'immenses salles basses, des forêts de stalactites, presque pas de dénivelé.
        "plaine": (
            poids: 1.0,
            forme: (
                zones: 6.0, verticalite: 0.05, part_plaine: 0.9, ecart: -0.15, profondeur: 80.0, boucles: 2.0,
                plaine_rayon: 62.0, plaine_hauteur: 13.0, plaine_stalactites: 0.8, plaine_stalagmites: 0.3,
                plaine_piliers: 0.35, stalactite_longueur: 9.0,
            ),
        ),
        // Des salles pleines de bosses, de trous et de ponts de roche, sur plusieurs hauteurs.
        "chaos": (
            poids: 1.0,
            forme: (
                zones: 8.0, verticalite: 0.2, part_plaine: 0.1, ecart: -0.2, boucles: 2.0,
                chaos_rayon: 34.0, chaos_hauteur: 46.0, chaos_bruit: 1.1, chaos_echelle: 18.0, chaos_detail: 0.6,
                chaos_stalactites: 0.3,
            ),
        ),
        // Un peu de tout.
        "mixte": (
            poids: 1.0,
            forme: (zones: 9.0, verticalite: 0.45, part_plaine: 0.5, ecart: 0.0),
        ),
    },
)
