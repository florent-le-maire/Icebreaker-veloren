// Icebreaker : réglages de la grotte (lieu « Grotte », docs/icebreaker/PLAN-GROTTE.md, jalon K).
// Sa forme (zones, puits, sentier) vient de formes.ron, à côté (jalon U, docs/icebreaker/PLAN-CAVERNE.md) ; ici, ce
// qui y vit.
(
    // Icebreaker I.11 : tronçons (32 blocs) réservés autour de la bouche, de chaque côté ; la grotte et celles refaites
    // à sa place pour une expédition (I.12) y tiennent : l'emprise d'une forme (formes.ron) est ramenée à cette valeur.
    emprise: 9,
    // Hauteur des cristaux luisants (K.3), en blocs (min, max).
    hauteur_cristaux: (3, 7),
    // Filons (K.4) : minerais en sprites minables (à la pioche) sur le sol au pied des parois, hors du sentier : chance
    // par bloc ; minerais par niveau (nom de sprite, poids), de l'entrée au fond de la grotte (le niveau d'une zone
    // vient de sa distance à l'entrée le long du sentier).
    // Habitants (K.5) : dans chaque zone, par_poche créatures (min, max) plus par_niveau par niveau ; dans chaque
    // niche, une créature avec la chance trous et un coffre (sprite coffre, butin de butin.ron selon le niveau, B.5)
    // avec la chance coffres ; le chef de la race (H.4) dans la zone la plus loin de l'entrée. part_solitaires (H.4) :
    // part des monstres solitaires de l'ambiance parmi les créatures des zones, les autres sont de la race ; les niches
    // n'ont que des solitaires. calme (U.8) : aucune créature à moins de ce nombre de blocs de la salle sûre, où
    // l'équipe arrive (la grotte n'a plus de bouche en surface).
    population: (par_poche: (2, 3), par_niveau: 1, trous: 0.5, coffres: 0.3, coffre: "DungeonChest2", part_solitaires: 0.3, calme: 30),
    filons: (
        chance: 0.008,
        paliers: [
            [("Copper", 3.0), ("Tin", 3.0), ("Iron", 2.0)],
            [("Coal", 3.0), ("Cobalt", 2.0), ("Silver", 1.0)],
            [("Gold", 3.0), ("Amethyst", 1.0), ("Ruby", 1.0), ("Sapphire", 1.0), ("Emerald", 1.0)],
        ],
    ),
    // Ambiances (K.3) : une par grotte, tirée par la graine ou demandée (-Ambiance du lanceur, variable
    // ICEBREAKER_GROTTE_AMBIANCE). roche : couleur des parois ; lueur : couleur de la roche luisante et sa part dans
    // les parois ; sol et plafond : sprites de Veloren (nom, chance par bloc) ; cristaux luisants par zone ;
    // solitaires (H.4) : les monstres sans race de l'ambiance (entités de Veloren), l'araignée des cavernes partout.
    ambiances: {
        "champignons": (
            roche: (70, 80, 60), lueur: (40, 110, 180), lueur_chance: 0.04,
            sol: [("GlowMushroom", 0.004), ("CaveMushroom", 0.003), ("Mushroom", 0.002), ("GrassBlueMedium", 0.004), ("SporeReed", 0.002)],
            plafond: [("MycelBlue", 0.006), ("CeilingMushroom", 0.004)],
            solitaires: ["common.entity.wild.aggressive.cave_spider", "common.entity.wild.peaceful.truffler", "common.entity.wild.peaceful.fungome", "common.entity.wild.aggressive.cave_troll"],
            cristaux: (0, 1),
        ),
        "cristaux": (
            roche: (80, 80, 95), lueur: (150, 120, 230), lueur_chance: 0.008,
            sol: [("CrystalLow", 0.004), ("CrystalHigh", 0.002), ("Amethyst", 0.001), ("Stones", 0.002)],
            plafond: [("CrystalHigh", 0.004)],
            solitaires: ["common.entity.wild.aggressive.dodarock", "common.entity.wild.aggressive.cave_spider", "common.entity.wild.aggressive.cave_salamander"],
            cristaux: (3, 7),
        ),
        "ossuaire": (
            roche: (75, 70, 60), lueur: (200, 150, 60), lueur_chance: 0.02,
            sol: [("Bones", 0.006), ("EnsnaringWeb", 0.004), ("Stones", 0.003), ("Mud", 0.002), ("DeadBush", 0.002)],
            plafond: [("EnsnaringWeb", 0.004)],
            solitaires: ["common.entity.wild.aggressive.cave_spider", "common.entity.wild.aggressive.blue_oni", "common.entity.wild.aggressive.red_oni", "common.entity.wild.peaceful.bat"],
            cristaux: (0, 0),
        ),
    },
    // Habitants (H.4) : une race par grotte, tirée par la graine parmi especes (ou -Race du lanceur) ; rôles des classes
    // des joueurs (icebreaker/ennemis/) ; chef : au fond, avec les capacités du chef gnarling.
    habitants: ["icebreaker.ennemis.guerrier", "icebreaker.ennemis.archer", "icebreaker.ennemis.mage"],
    chef: "icebreaker.ennemis.chef",
    especes: ["human", "orc", "dwarf", "elf", "draugr", "danari"],
)
