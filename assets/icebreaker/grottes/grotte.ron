// Icebreaker : réglages de la grotte (lieu « Grotte », docs/icebreaker/PLAN-GROTTE.md, jalon K).
(
    // Entrée (K.1) : un boyau de la bouche (en surface) au centre de la première poche.
    entree: (profondeur: 18, longueur: 36, rayon: 3.0),
    // Poche : un ellipsoïde ; rayon horizontal et demi-hauteur en blocs (min, max).
    poche: (rayon: (10, 14), hauteur: (5, 7)),
    // Réseau (K.2) : poches (la première comprise) réparties sur des niveaux de profondeur, chacune accrochée par un
    // boyau à une poche du niveau au-dessus ; ecart : blocs entre les parois de deux poches liées ; boucles : boyaux
    // en plus entre les poches les plus proches ; culs-de-sac : tubes étroits qui partent de chaque poche (les trous
    // d'où sortent les bêtes), longueur et rayon en blocs.
    reseau: (
        poches: (6, 10),
        niveaux: 3,
        ecart_niveau: 16,
        ecart: (30, 48),
        rayon_boyau: (3, 5),
        boucles: (1, 2),
        culs_de_sac: (1, 2),
        longueur_cul_de_sac: (8, 16),
        rayon_cul_de_sac: 2.0,
    ),
    // Relief (K.3) : bosses = hauteur des bosses du sol (blocs) ; rugosite = de combien les parois d'une poche
    // s'écartent de l'ellipsoïde (part du rayon) ; hauteur_concretions = stalagmites, stalactites et cristaux (blocs).
    relief: (bosses: 1.0, rugosite: 0.18, hauteur_concretions: (3, 7)),
    // Filons (K.4) : minerais en sprites minables (à la pioche) au pied des parois des poches : chance par bloc du
    // bord du sol (bord : à partir de quelle part du rayon, au carré, le sol compte comme le bord) ; minerais par
    // niveau de profondeur (nom de sprite, poids), le dernier palier servant aux niveaux plus profonds.
    filons: (
        chance: 0.06,
        bord: 0.55,
        paliers: [
            [("Copper", 3.0), ("Tin", 3.0), ("Iron", 2.0)],
            [("Coal", 3.0), ("Cobalt", 2.0), ("Silver", 1.0)],
            [("Gold", 3.0), ("Amethyst", 1.0), ("Ruby", 1.0), ("Sapphire", 1.0), ("Emerald", 1.0)],
        ],
    ),
    // Ambiances (K.3) : une par grotte, tirée par la graine ou demandée (-Ambiance du lanceur, variable
    // ICEBREAKER_GROTTE_AMBIANCE). roche : couleur du sol ; lueur : couleur de la roche luisante et sa part dans le
    // sol ; sol et plafond : sprites de Veloren (nom, chance par bloc) ; stalagmites, stalactites, cristaux par poche.
    ambiances: {
        "champignons": (
            roche: (70, 80, 60), lueur: (40, 110, 180), lueur_chance: 0.04,
            sol: [("GlowMushroom", 0.04), ("CaveMushroom", 0.03), ("Mushroom", 0.02), ("GrassBlueMedium", 0.03), ("SporeReed", 0.02)],
            plafond: [("MycelBlue", 0.05), ("CeilingMushroom", 0.03)],
            stalagmites: (2, 5), stalactites: (3, 8), cristaux: (0, 1),
        ),
        "cristaux": (
            roche: (80, 80, 95), lueur: (150, 120, 230), lueur_chance: 0.06,
            sol: [("CrystalLow", 0.03), ("CrystalHigh", 0.015), ("Amethyst", 0.005), ("Stones", 0.01)],
            plafond: [("CrystalHigh", 0.03)],
            stalagmites: (1, 3), stalactites: (2, 5), cristaux: (3, 7),
        ),
        "ossuaire": (
            roche: (75, 70, 60), lueur: (200, 150, 60), lueur_chance: 0.02,
            sol: [("Bones", 0.05), ("EnsnaringWeb", 0.03), ("Stones", 0.02), ("Mud", 0.01), ("DeadBush", 0.01)],
            plafond: [("EnsnaringWeb", 0.03)],
            stalagmites: (3, 7), stalactites: (4, 9), cristaux: (0, 0),
        ),
    },
)
