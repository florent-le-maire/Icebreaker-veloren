// Icebreaker U.18 : les minerais des filons de la grotte (docs/icebreaker/design/filons.md). Un filon est une bande
// de blocs de couleur prise dans la roche des parois ; on la casse à la pioche, morceau par morceau.
// Par minerai :
//   couleur   : couleur de ses blocs (R, V, B) ; c'est à elle que le jeu reconnaît le minerai : deux minerais n'ont
//               pas la même, et aucune roche d'ambiance de grotte.ron ne l'a ;
//   lueur     : true, ses blocs luisent (roche luisante) ;
//   coups     : coups de pioche pour qu'un bloc cède ; energie : énergie payée à chaque coup (la roche : 3 et 15,
//               destruction.ron) ;
//   objet     : ce que donne un bloc qui cède (un objet de Veloren) ; quantite : combien (min, max) ;
//   morceau   : distance en blocs autour du bloc visé où les blocs du même minerai cèdent avec lui (0 : un bloc à
//               la fois) ;
//   filon     : sa forme. longueur : blocs parcourus le long de la paroi (min, max) ; epaisseur : largeur de la
//               bande (min, max) ; profondeur : blocs pris dans la roche sous la surface ; sinuosite : de 0 (droit)
//               à 1 (tourne sans cesse) ; relief : part des blocs de surface qui ressortent d'un bloc dans le vide ;
//   poids     : son poids au tirage d'un filon, par niveau de la grotte (de l'entrée au fond ; le dernier vaut pour
//               les niveaux plus profonds ; 0 : absent à ce niveau) ;
//   salle     : son poids au tirage des filons de la salle au minerai (0 : absent).
(
    minerais: {
        "cuivre": (
            couleur: (196, 110, 52), lueur: false, coups: 1, energie: 15.0,
            objet: "common.items.mineral.ore.copper", quantite: (1, 1), morceau: 0.0,
            filon: (longueur: (10, 16), epaisseur: (1, 2), profondeur: 1, sinuosite: 0.4, relief: 0.3),
            poids: [3.0, 1.0, 0.0], salle: 3.0,
        ),
        "etain": (
