// Icebreaker U.18 : les minerais des filons de la grotte (docs/icebreaker/design/filons.md). Un filon est une bande
// de blocs prise dans la roche des parois ; on la casse à la pioche, morceau par morceau. Chaque bloc est un sprite
// à nous (U.24) : son modèle vient de icebreaker-modeles (src/filons.rs).
// Par minerai :
//   sprite    : le sprite d'un bloc de ce minerai (IcebreakerFilon…, minable à la pioche) ; c'est à lui que le jeu
//               reconnaît le minerai : deux minerais n'ont pas le même ;
//   couleur   : sa couleur (R, V, B) : les éclats quand un bloc cède, les filons dans l'atelier des grottes ; les
//               modèles ont la même (icebreaker-modeles/src/filons.rs) ;
//   coups     : coups de pioche pour qu'un bloc cède ; energie : énergie payée à chaque coup (la roche : 3 et 15,
//               destruction.ron) ;
//   objet     : ce que donne un bloc qui cède (un objet de Veloren) ; quantite : combien (min, max) ;
//   morceau   : distance en blocs autour du bloc visé où les blocs du même minerai cèdent avec lui (0 : un bloc à
//               la fois). Les courants (cuivre, étain, fer, charbon) partent par 19 blocs au plus (1.5), les moyens
//               (cobalt, argent) par 7 (1.0), les rares (or, gemmes) bloc par bloc ;
//   filon     : sa forme. longueur : blocs parcourus le long de la paroi (min, max) ; epaisseur : largeur de la
//               bande (min, max) ; profondeur : blocs pris dans la roche sous la surface ; sinuosite : de 0 (droit)
//               à 1 (tourne sans cesse) ; relief : part des blocs de surface qui ressortent d'un bloc dans le vide ;
//   poids     : son poids au tirage d'un filon, par niveau de la grotte (de l'entrée au fond ; le dernier vaut pour
//               les niveaux plus profonds ; 0 : absent à ce niveau) ;
//   salle     : son poids au tirage des filons de la salle au minerai (0 : absent).
(
    minerais: {
        "cuivre": (
            sprite: IcebreakerFilonCuivre, couleur: (196, 110, 52),
            coups: 1, energie: 15.0,
            objet: "common.items.mineral.ore.copper", quantite: (1, 1), morceau: 1.5,
            filon: (longueur: (10, 16), epaisseur: (1, 2), profondeur: 1, sinuosite: 0.4, relief: 0.3),
            poids: [3.0, 1.0, 0.0], salle: 3.0,
        ),
        "etain": (
            sprite: IcebreakerFilonEtain, couleur: (168, 186, 160),
            coups: 1, energie: 15.0,
            objet: "common.items.mineral.ore.tin", quantite: (1, 1), morceau: 1.5,
            filon: (longueur: (10, 16), epaisseur: (1, 2), profondeur: 1, sinuosite: 0.4, relief: 0.3),
            poids: [3.0, 1.0, 0.0], salle: 3.0,
        ),
        "fer": (
            sprite: IcebreakerFilonFer, couleur: (150, 70, 50),
            coups: 1, energie: 15.0,
            objet: "common.items.mineral.ore.iron", quantite: (1, 1), morceau: 1.5,
            filon: (longueur: (12, 18), epaisseur: (1, 2), profondeur: 1, sinuosite: 0.3, relief: 0.3),
            poids: [2.0, 2.0, 1.0], salle: 4.0,
        ),
        // Le charbon : une couche épaisse et tendre.
        "charbon": (
            sprite: IcebreakerFilonCharbon, couleur: (44, 44, 50),
            coups: 1, energie: 12.0,
            objet: "common.items.mineral.ore.coal", quantite: (1, 1), morceau: 1.5,
            filon: (longueur: (14, 22), epaisseur: (2, 3), profondeur: 2, sinuosite: 0.2, relief: 0.2),
            poids: [1.0, 3.0, 1.0], salle: 3.0,
        ),
        "cobalt": (
            sprite: IcebreakerFilonCobalt, couleur: (40, 80, 200),
            coups: 1, energie: 18.0,
            objet: "common.items.mineral.ore.cobalt", quantite: (1, 1), morceau: 1.0,
            filon: (longueur: (8, 14), epaisseur: (1, 2), profondeur: 1, sinuosite: 0.5, relief: 0.4),
            poids: [0.0, 2.0, 2.0], salle: 1.0,
        ),
        "argent": (
            sprite: IcebreakerFilonArgent, couleur: (225, 228, 238),
            coups: 1, energie: 18.0,
            objet: "common.items.mineral.ore.silver", quantite: (1, 1), morceau: 1.0,
            filon: (longueur: (8, 14), epaisseur: (1, 2), profondeur: 1, sinuosite: 0.5, relief: 0.4),
            poids: [0.0, 1.0, 2.0], salle: 2.0,
        ),
        "or": (
            sprite: IcebreakerFilonOr, couleur: (240, 190, 40),
            coups: 1, energie: 20.0,
            objet: "common.items.mineral.ore.gold", quantite: (1, 1), morceau: 0.0,
            filon: (longueur: (8, 14), epaisseur: (1, 2), profondeur: 1, sinuosite: 0.6, relief: 0.4),
            poids: [0.0, 0.0, 3.0], salle: 1.0,
        ),
        // Les gemmes : de petits amas qui luisent, durs.
        "amethyste": (
            sprite: IcebreakerFilonAmethyste, couleur: (165, 80, 225),
            coups: 1, energie: 22.0,
            objet: "common.items.mineral.gem.amethyst", quantite: (1, 1), morceau: 0.0,
            filon: (longueur: (3, 6), epaisseur: (2, 3), profondeur: 1, sinuosite: 0.8, relief: 0.6),
            poids: [0.0, 0.0, 1.0], salle: 0.5,
        ),
        "rubis": (
            sprite: IcebreakerFilonRubis, couleur: (220, 30, 50),
            coups: 1, energie: 22.0,
            objet: "common.items.mineral.gem.ruby", quantite: (1, 1), morceau: 0.0,
            filon: (longueur: (3, 6), epaisseur: (2, 3), profondeur: 1, sinuosite: 0.8, relief: 0.6),
            poids: [0.0, 0.0, 1.0], salle: 0.5,
        ),
        "saphir": (
            sprite: IcebreakerFilonSaphir, couleur: (40, 120, 255),
            coups: 1, energie: 22.0,
            objet: "common.items.mineral.gem.sapphire", quantite: (1, 1), morceau: 0.0,
            filon: (longueur: (3, 6), epaisseur: (2, 3), profondeur: 1, sinuosite: 0.8, relief: 0.6),
            poids: [0.0, 0.0, 1.0], salle: 0.5,
        ),
        "emeraude": (
            sprite: IcebreakerFilonEmeraude, couleur: (30, 200, 90),
            coups: 1, energie: 22.0,
            objet: "common.items.mineral.gem.emerald", quantite: (1, 1), morceau: 0.0,
            filon: (longueur: (3, 6), epaisseur: (2, 3), profondeur: 1, sinuosite: 0.8, relief: 0.6),
            poids: [0.0, 0.0, 1.0], salle: 0.5,
        ),
    },
)
