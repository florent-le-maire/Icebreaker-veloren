// Icebreaker : le plan du village (touche U par défaut,
// `voxygen/src/session/icebreaker_vue.rs`), dessiné par le HUD dans la fenêtre du village
// (`voxygen/src/hud/icebreaker.rs`, jalon N).
(
    // Couleur (rouge, vert, bleu de 0 à 1) du point qui marque le joueur (rien pour un fantôme).
    couleur_joueur: (1.0, 1.0, 1.0),
    // Distance en blocs de l'ouverture au-delà de laquelle le plan se ferme de lui-même
    // (téléportation, retour au village).
    rayon_sortie: 120.0,
    // Apparence de chaque sorte de bâtiment sur le plan (X.4) : couleur (rouge, vert, bleu de 0 à 1) du
    // cadre et du nom, et icône du HUD parmi : utilitaire, potion, vivres, globe, outils, armes, armure, buche,
    // lingot, planeur (ou rien). Les sortes : entrepot, caisse, intendance, forge, depart, charrette, salle_armes,
    // terrain (à bâtir), chantier.
    apparences: {
        "entrepot": (couleur: (0.95, 0.75, 0.3), icone: "utilitaire"),
        "caisse": (couleur: (1.0, 0.9, 0.2), icone: "lingot"),
        "intendance": (couleur: (0.4, 0.8, 1.0), icone: "vivres"),
        "forge": (couleur: (1.0, 0.45, 0.45), icone: "outils"),
        "depart": (couleur: (0.8, 0.55, 1.0), icone: "globe"),
        "charrette": (couleur: (0.6, 1.0, 0.6), icone: "armure"),
        "salle_armes": (couleur: (0.85, 0.6, 0.35), icone: "epees"),
        "terrain": (couleur: (0.3, 0.9, 0.3), icone: "buche"),
        "chantier": (couleur: (1.0, 0.6, 0.2), icone: "outils"),
        // Icebreaker O : les deux cases du lieu d'entraînement.
        "entrainement_perso": (couleur: (0.6, 1.0, 0.6), icone: "armure"),
        "entrainement_arene": (couleur: (1.0, 0.45, 0.45), icone: "epees"),
    },
)
