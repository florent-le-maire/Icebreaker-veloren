// Icebreaker : le village qui grandit (jalon C, docs/icebreaker/PLAN.md).
//
// La ville complète est prévue dès le départ ; ses maisons sont rangées de la plus
// proche à la plus éloignée de la place. Les 7 premières tiennent les bâtiments
// (entrepôt, caisse, intendance, forge, départ, charrette, salle d'armes) et sont toujours bâties. Les autres
// sont des terrains à bâtir. Ce qui est bâti est gardé dans la campagne
// (`campagne/village.ron`).
// Icebreaker VF : au village fixe (`village_plan.ron`, décision 0022), les bâtiments sont les lieux
// de même id du plan (la caisse dans la Guilde, avec la charrette), puis les lieux à palier.
(
    // Maisons bâties au début de la campagne (bâtiments compris).
    maisons_au_depart: 8,
    // Habitants (gardes, marchands, aventuriers, villageois) par maison bâtie.
    habitants_par_maison: 2,
    // Terrains à bâtir proposés à la fois, les plus proches de la place d'abord.
    terrains_ouverts: 6,
    // Prix d'une maison, en pièces d'or de la caisse.
    prix_maison: 300,
    // Durée d'un chantier de maison, en heures de carte (1 min réelle = 30 min de carte).
    heures_chantier: 6.0,
    // Enseignes de chaque bâtiment (X.4) : sprites de Veloren (noms de `SpriteKind`) posés sur la route de
    // part et d'autre de la porte, le premier à droite, le deuxième à gauche, puis plus loin.
    enseignes: {
        "entrepot": ["Crate", "Barrel", "Crate", "Barrel"],
        "caisse": ["Chest", "Lantern", "Chest", "Lantern"],
        "intendance": ["Crate", "Lantern", "Barrel", "Crate"],
        "forge": ["Anvil", "Barrel", "Lantern", "Crate"],
        "depart": ["Sign", "Tent", "Lantern", "Sign"],
        "charrette": ["Crate", "Barrel", "Sign", "Crate"],
        "salle_armes": ["Anvil", "Lantern", "Barrel", "Anvil"],
    },
)
