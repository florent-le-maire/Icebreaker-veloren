// Icebreaker : lieux de la campagne.
// - Menu principal (voxygen/src/menu/main/ui/icebreaker.rs) : un bouton par lieu `au_menu: true` ; il lance
//   `icebreaker.ps1 <arguments> -Port <port>` si rien n'écoute sur ce port, puis s'y connecte (le client réessaie
//   toutes les 5 s pendant que le monde se génère). Décision 0016 : la campagne tient en un seul serveur.
// - Chef d'expédition (maison « Départ ») : les destinations sont les autres lieux ; dans la campagne, leur site
//   (`-Site`) choisit l'emplacement de donjon (assets/icebreaker/campagne.ron). Lancés seuls (sans la campagne),
//   ces lieux restent utiles pour tester un donjon.
// Un port par lieu ; le port suivant (port + 1) est pris par l'interface web du serveur.
// Icebreaker H.5 : le fort gnarling n'est plus une destination (les donjons sont peuplés de races) ; il se lance
// encore seul : `icebreaker.ps1 donjon -Site Gnarling`.
// `actif: false` : lieu pas encore fait.
// `description` (N.6, facultative) : la ligne d'explication sous le bouton du menu (lue par le client seulement).
// `adresse` (S.3) : serveur distant ; le bouton s'y connecte sans rien lancer ni choisir de partie (la partie est
// celle du serveur). Ses `arguments` et son `port` ne servent pas au client.
[
    (nom: "Campagne", arguments: ["campagne"], port: 14100, actif: true, au_menu: true,
        description: "Le serveur tourne sur cet ordinateur."),
    (nom: "En ligne", arguments: ["campagne"], port: 14100, actif: true, au_menu: true,
        adresse: Some("116.202.107.125:14100"), description: "Rejoint le serveur de l'équipe et sa partie."),
    (nom: "Donjon généré", arguments: ["donjon", "-Site", "Genere"], port: 14130, actif: true),
    (nom: "Grotte", arguments: ["donjon", "-Site", "Grotte"], port: 14140, actif: true),
    // Icebreaker O : lieu d'entraînement (`docs/icebreaker/PLAN-ENTRAINEMENT.md`), pas une destination d'expédition.
    // `sans_partie` : pas de partie à choisir, le bouton lance le serveur et s'y connecte.
    (nom: "Entraînement", arguments: ["entrainement"], port: 14150, actif: true, au_menu: true, sans_partie: true,
        description: "Classe, armes et sorts libres ; ennemis et alliés à la demande."),
    (nom: "Route", arguments: ["route"], port: 14120, actif: false),
    // Icebreaker FO.6 : la forêt (docs/icebreaker/PLAN-FORET.md). En dernier, pour ne pas changer le numéro des
    // autres destinations de `/expedition`.
    (nom: "Forêt", arguments: ["donjon", "-Site", "Foret"], port: 14170, actif: true),
]
