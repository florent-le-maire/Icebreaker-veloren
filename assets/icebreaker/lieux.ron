// Icebreaker : lieux de la campagne.
// - Menu principal (voxygen/src/menu/main/ui/icebreaker.rs) : un bouton par lieu `au_menu: true` ; il lance
//   `icebreaker.ps1 <arguments> -Port <port>` si rien n'écoute sur ce port, puis s'y connecte (le client réessaie
//   toutes les 5 s pendant que le monde se génère). Décision 0016 : la campagne tient en un seul serveur.
// - Chef d'expédition (maison « Départ ») : les destinations sont les autres lieux ; dans la campagne, leur site
//   (`-Site`) choisit l'emplacement de donjon (assets/icebreaker/campagne.ron). Lancés seuls (sans la campagne),
//   ces lieux restent utiles pour tester un donjon.
// Un port par lieu ; le port suivant (port + 1) est pris par l'interface web du serveur.
// `actif: false` : lieu pas encore fait.
[
    (nom: "Campagne", arguments: ["campagne"], port: 14100, actif: true, au_menu: true),
    (nom: "Donjon", arguments: ["donjon", "-Site", "Gnarling"], port: 14110, actif: true),
    (nom: "Donjon généré", arguments: ["donjon", "-Site", "Genere"], port: 14130, actif: true),
    (nom: "Grotte", arguments: ["donjon", "-Site", "Grotte"], port: 14140, actif: true),
    (nom: "Route", arguments: ["route"], port: 14120, actif: false),
]
