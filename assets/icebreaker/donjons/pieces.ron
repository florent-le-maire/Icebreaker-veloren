        "boucliers_mur": (nom: "Boucliers au mur", lot: 4, idee: "contre un mur : deux boucliers et deux armes croisées"),
        "fers_mur": (nom: "Fers au mur", lot: 4, idee: "contre un mur : un anneau, deux chaînes et des menottes"),
        "tas_pieces": (nom: "Tas de pièces", lot: 4, idee: "un monticule d'or, décor seulement (rien à ramasser)"),
        "coffre_pied": (nom: "Coffre de pied de lit", lot: 4, idee: "petit coffre de bois fermé, décor seulement"),
        "casier_bouteilles": (nom: "Casier à bouteilles", lot: 5, idee: "contre un mur : des rangs de bouteilles couchées"),
        "lingots": (nom: "Lingots", lot: 5, idee: "une pile de barres de fer"),
        "cible": (nom: "Cible", lot: 5, idee: "cible de paille sur trépied, flèches plantées"),
        "pilori": (nom: "Pilori", lot: 5, idee: "poteau et planche à trois trous"),
        "idole": (nom: "Idole", lot: 5, idee: "statue trapue de la divinité du culte, yeux lumineux"),
