    // Les modèles voxel à créer (F.13), par lots de cinq environ : le lot 1 d'abord.
    modeles: {
        "ratelier_armes": (nom: "Râtelier d'armes", lot: 1, idee: "contre un mur : un cadre de bois, épées et lances debout"),
        "presentoir_armure": (nom: "Armure sur pied", lot: 1, idee: "un mannequin de bois qui porte plastron et heaume (remplace le « heaume » actuel, qui est une barre de navire)"),
        "autel": (nom: "Autel", lot: 1, idee: "bloc de pierre, nappe sombre, deux bougies"),
        "cage": (nom: "Cage", lot: 1, idee: "cage de fer d'un bloc, barreaux serrés, sert en prison, au chenil et en salle de torture"),
