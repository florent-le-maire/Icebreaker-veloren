        "banniere": (nom: "Bannière", lot: 2, idee: "contre un mur : une hampe et un long tissu, couleur à part de la tenture"),
        "alambic": (nom: "Table d'alchimie", lot: 2, idee: "table, alambic de cuivre, fioles de couleur"),
