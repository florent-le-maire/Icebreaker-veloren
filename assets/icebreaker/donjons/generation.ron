// Icebreaker : réglages du générateur de donjon (lieu « Genere », docs/icebreaker/PLAN.md, jalon G).
// Repris de game/data/dungeons/generation.json du projet Icebreaker (règles : docs/icebreaker/design/generation.md).
// Plages (min, max) inclusives. Les nombres de branches, verrous, boucles et chutes sont des maximums visés : le
// générateur en place moins s'il ne trouve pas d'endroit qui garde le donjon finissable.
(
    // Passage du plan aux blocs.
    render: (
        cell_size: 7,      // blocs par case (horizontalement) ; F.1 : 7 pour que la caméra reste dans le donjon
        level_height: 7,   // blocs par étage, sol compris ; au plus cell_size (escalier : une marche par bloc)
        // Sol, murs et plafond : materiaux.ron (Icebreaker F.27).
    ),

    // Graphe de mission (tâche G.3), par taille de donjon.
    sizes: {
        "small": (
            main_path: (4, 5),      // salles du chemin principal, entrée et objectif compris
            levels: (1, 2),         // étages traversés
            branches: (1, 2),       // culs-de-sac (dont ceux qui cachent une clé)
            branch_length: (1, 1),
            max_branches_per_room: 2,   // branches au plus par salle (ses portes sont limitées)
            locks: (0, 1),
            loops: (0, 1),
            drops: (0, 1),          // chutes à sens unique vers plus bas (raccourcis)
        ),
        "medium": (             // F.3 : 12 à 18 salles (7 à 15 avant)
            main_path: (7, 9),
            levels: (2, 3),
            branches: (3, 5),
            branch_length: (1, 2),
            max_branches_per_room: 2,
            locks: (1, 1),
            loops: (1, 2),
            drops: (0, 1),
        ),
        "large": (
            main_path: (9, 12),
            levels: (3, 4),
            branches: (5, 8),
            branch_length: (1, 3),
            max_branches_per_room: 2,
            locks: (1, 2),
            loops: (1, 2),
            drops: (1, 2),
        ),
    },
    // Rôles possibles des salles des branches, tirés au hasard parmi ceux qui respectent les règles ci-dessous
    // (répéter un rôle le rend plus fréquent).
    branch_roles: ["guardRoom", "barracks", "barracks", "storage", "storage", "kitchen", "kitchen", "nest", "nest", "treasure"],
    // Règles de cohérence : « des habitants crédibles ».
    rules: (
        guard_before_locks: true,   // la salle avant chaque porte fermée est une salle de garde
        fallback: "guardRoom",      // rôle pris quand aucun autre ne respecte les règles
        // next_to : rôles possibles de la salle d'où part la branche ; min_distance_from_main_path : 1 = accrochée au
        // chemin principal, 2 = au moins une salle entre les deux ; max : salles de ce rôle au plus par donjon.
        roles: {
            "barracks": (next_to: ["entrance", "guardRoom"], max: Some(2)),
            "storage": (next_to: ["kitchen"], max: Some(2)),
            "kitchen": (max: Some(1)),
            "nest": (min_distance_from_main_path: 2, max: Some(2)),
            "treasure": (max: Some(1)),
        },
    ),
    // Salles que chaque donjon a (F.20, `docs/icebreaker/design/donjon.md`, « Portail et autel ») : le portail du
    // retour au village et l'autel de résurrection. min : toujours autant ; max : jamais plus ; chaque salle au-delà
    // de min a une chance base + per_room × salles du donjon + per_level × étages (un petit : ~2 %, un grand : ~6 %).
    // Chacune est un cul-de-sac accroché à une salle peu chargée en portes, à min_distance_from_entrance passages au
    // moins de l'entrée (plus près s'il n'y a pas le choix), jamais sur la salle de l'objectif.
    special_rooms: {
        "portal": (min: 1, max: 2, min_distance_from_entrance: 3, extra: (base: 0.0, per_room: 0.002, per_level: 0.005)),
        "altar": (min: 1, max: 2, min_distance_from_entrance: 2, extra: (base: 0.0, per_room: 0.002, per_level: 0.005)),
    },
    // Salle au bout du chemin principal selon l'objectif de la mission.
    goal_roles: {
        "killChief": "chiefLair",
        "rescue": "prison",
        "loot": "vault",
        "clear": "nest",
        "explore": "sanctum",
        "bossLair": "bossLair",
    },
    // Variété des salles (F.2) : orientations de chaque salle dessinée, 1 (telle quelle), 2 (et son miroir), 4 (les
    // quarts de tour) ou 8 (les deux) ; les escaliers tournent avec la salle. Avec 8, presque toute salle a une porte
    // en face de la précédente : les couloirs sont courts.
    variety: (
        orientations: 8,
        // Salles générées (F.5, RoomShapes.cs du projet) mêlées aux salles dessinées des rôles de `roles` : share = part
        // visée (0,5 : autant que de dessinées) ; width, depth en cases, murs compris ; doors : portes possibles, dans
        // les pans droits ; min_bar : largeur minimale d'une branche (L, T, croix) ou d'un passage de grotte ; shapes :
        // poids de chaque forme (chamfer = coins coupés, l, t, cross, octagon, ellipse, cave). Par rôle : pillars et
        // chests en plus, shapes = formes permises (toutes sinon). Tirées pour chaque donjon (même graine, mêmes salles).
        // Entrée, antres et sanctuaire restent dessinés.
        shapes: (
            share: 0.5,
            width: (8, 12),
            depth: (6, 10),
            doors: (2, 4),
            min_bar: 2,
            shapes: {"chamfer": 2, "l": 2, "t": 2, "cross": 2, "octagon": 2, "ellipse": 2, "cave": 1},
            roles: {
                "hall": (pillars: (0, 2)),
                "guardRoom": (pillars: (0, 1)),
                "barracks": (pillars: (0, 2)),
                "kitchen": (pillars: (1, 3)),
                "storage": (chests: (0, 1)),
                "prison": (pillars: (0, 1)),
                "nest": (shapes: Some([cave, ellipse])),
                "treasure": (chests: (2, 4), shapes: Some([ellipse, octagon, chamfer, cross])),
                "vault": (chests: (2, 3), pillars: (0, 2), shapes: Some([octagon, ellipse, cross])),
            },
        ),
    ),
    // Assemblage (tâche G.4) : placement des salles et creusement des couloirs.
    assembly: (
        attempts: 20,           // tentatives complètes avant d'abandonner
        placement_tries: 40,    // essais pour placer une salle
        extra_passage_tries: 8, // essais pour une boucle ou une chute (abandonnée sinon)
        max_extra_length: 24,   // cases au plus pour le couloir d'une boucle ou d'une chute (F.2 : sinon, abandonnée)
        spacing: (1, 3),        // cases entre une porte et la salle suivante (F.2 : couloirs courts)
        search_limit: 3000,     // cases examinées par recherche de couloir
        margin: 6,              // marge autour du donjon où un couloir peut passer
        // Icebreaker : chaque donjon a un thème dominant (tiré de sa graine : militaire, culte, bestial…, ceux que
        // nomment les salles `@theme:`) ; une salle de ce thème pèse autant de fois plus dans le tirage (1 = sans effet).
        theme_bias: 4.0,
        // Icebreaker F.46 : la silhouette du plan (idée des « dungeon layouts » de donjon.bin.sh) : salles et couloirs
        // restent dans cette forme, la même à chaque étage. Libre (aucune), Carre, Rectangle, Croix, Rond, Couronne,
        // Diagonales, Losange, Hexagone ; etendue : cases du milieu de la forme à son bord (8 à 56) pour un donjon de
        // 18 salles ; elle suit la taille du donjon (racine du nombre de salles : un grand a une forme plus large, un
        // petit plus serrée), sans dépasser 56. Trop serrée, la forme est abandonnée (le résumé du donjon le dit).
        // Un preset de formes.ron les change.
        silhouette: Libre,
        etendue: 40,
        // Icebreaker F.47 : le style des couloirs (idée des « corridors » de donjon.bin.sh). sinuosite : 0 = le plus
        // court chemin, 100 = un dédale (ne se voit que si les salles sont écartées : spacing) ; impasses : couloirs
        // sans issue de 2 à 5 cases, creusés depuis les autres couloirs.
        sinuosite: 0,
        impasses: (0, 0),
        // Icebreaker F.48 : chances sur 100 qu'une salle soit posée contre celle d'où l'on vient, porte contre porte,
        // sans couloir (les « salles collées » de design/generation.md) ; si elle ne tient pas, un couloir.
        collees: 0,
    ),
    // Habitants et butin selon le rôle de la salle (tâche G.5). creatures : nombre par sorte (brute, archer, lookout,
    // chief, boss, beast) ; chests : coffres ; awake : éveillées (false : endormies, voir `sleep`).
    // Rôle absent : salle vide. Le chef garde toujours la salle de l'objectif.
    // F.4 : valeurs relevées (le donjon était vide) ; sorte `beast` (bêtes des nids).
    population: {
        "entrance": (creatures: {"lookout": (0, 1)}),
        "hall": (creatures: {"lookout": (1, 2)}),
        "guardRoom": (creatures: {"brute": (2, 3), "archer": (1, 2)}),
        "barracks": (creatures: {"brute": (3, 5)}, awake: false),
        "storage": (creatures: {"lookout": (1, 2)}, chests: (1, 2)),
        "kitchen": (creatures: {"brute": (1, 2), "lookout": (1, 2)}),
        "nest": (creatures: {"beast": (3, 5)}, awake: false),
        "treasure": (creatures: {"brute": (1, 2), "archer": (1, 1)}, chests: (2, 3)),
        "chiefLair": (creatures: {"chief": (1, 1), "archer": (2, 3), "brute": (1, 2)}),
        "prison": (creatures: {"brute": (2, 3)}),
        "vault": (creatures: {"brute": (2, 3), "archer": (1, 1)}, chests: (3, 4)),
        "sanctum": (creatures: {"archer": (2, 3)}, chests: (1, 1)),
        "bossLair": (creatures: {"boss": (1, 1), "brute": (0, 2)}, chests: (1, 2)),
    },
    // Les couloirs aussi (F.4) : pour chaque tranche de per_cells cases de couloir, ces créatures (jamais sur un
    // escalier, un palier ni devant une porte) ; mêmes facteurs de menace et de nombre d'ennemis que les salles.
    corridors: (creatures: {"lookout": (1, 1)}, per_cells: 10),
    // Qui habite le donjon : pour chaque sorte des plans, des créatures de Veloren (tirées au hasard dans la liste) ;
    // chest : le sprite du coffre (DungeonChest0 = gnarlings, 1 = adlets, 5 = cultistes) ; son butin vient de butin.ron (B.5).
    // H.2 : la faction « races » (par défaut) = des humanoïdes d'une race, une seule par donjon, tirée par la graine
    // parmi especes (ou -Race du lanceur) ; rôles des classes des joueurs (icebreaker/ennemis/). Les autres factions
    // restent pour -Faction.
    default_faction: "races",
    // H.3 : les monstres solitaires, sans race : ils habitent les nids (sorte beast) d'une faction qui n'a pas les siens.
    solitaires: [
        "common.entity.wild.aggressive.cave_spider",
        "common.entity.dungeon.gnarling.mandragora",
        "common.entity.wild.aggressive.frostfang",
    ],
    factions: {
        "races": (
            creatures: {
                "brute": ["icebreaker.ennemis.guerrier"],
                "archer": ["icebreaker.ennemis.archer", "icebreaker.ennemis.mage"],
                "lookout": ["icebreaker.ennemis.guerrier", "icebreaker.ennemis.archer", "icebreaker.ennemis.mage"],
                "chief": ["icebreaker.ennemis.chef"],
                "boss": ["icebreaker.ennemis.chef"],
            },
            especes: ["human", "orc", "dwarf", "elf", "draugr", "danari"],
            chest: "DungeonChest0",
        ),
        "gnarling": (
            creatures: {
                "brute": ["common.entity.dungeon.gnarling.logger"],
                "beast": ["common.entity.dungeon.gnarling.mandragora"],
                "archer": ["common.entity.dungeon.gnarling.stalker"],
                "lookout": ["common.entity.dungeon.gnarling.mugger"],
                "chief": ["common.entity.dungeon.gnarling.chieftain"],
                "boss": ["common.entity.dungeon.gnarling.harvester"],
            },
            chest: "DungeonChest0",
        ),
        "adlet": (
            creatures: {
                "brute": ["common.entity.dungeon.adlet.icepicker"],
                "beast": ["common.entity.wild.aggressive.frostfang"],
                "archer": ["common.entity.dungeon.adlet.hunter"],
                "lookout": ["common.entity.dungeon.adlet.tracker"],
                "chief": ["common.entity.dungeon.adlet.elder"],
                "boss": ["common.entity.dungeon.adlet.yeti"],
            },
            chest: "DungeonChest1",
        ),
        "cultist": (
            creatures: {
                "brute": ["common.entity.dungeon.cultist.husk_brute"],
                "beast": ["common.entity.dungeon.cultist.hound"],
                "archer": ["common.entity.dungeon.cultist.warlock"],
                "lookout": ["common.entity.dungeon.cultist.cultist", "common.entity.dungeon.cultist.husk"],
                "chief": ["common.entity.dungeon.cultist.warlord"],
                "boss": ["common.entity.dungeon.cultist.mindflayer"],
            },
            chest: "DungeonChest5",
        ),
    },
    // Paramètres de la mission (tâche G.6) : région, saison, menace, nombre d'ennemis et objectif changent le donjon.
    // Valeurs du projet Icebreaker, à régler en jouant. Les écarts s'ajoutent, les facteurs se multiplient :
    //   main_path, levels, branches : salles du chemin principal, étages, branches en plus (ou en moins) ;
    //   rooms : facteur du poids d'un rôle des branches (0 : jamais) ;
    //   creature_factor : facteur du nombre de créatures (le chef et le boss restent uniques) ; creatures : par sorte ;
    //   chests : facteur du nombre de coffres. name : affiché dans le résumé du donjon (journal du serveur).
    parameters: (
        regions: {
            "forest": (name: "Forêt", rooms: {"nest": 2, "kitchen": 1.5}, creatures: {"archer": 1.5}),
            "mountain": (name: "Montagne", levels: 1, main_path: 1, rooms: {"barracks": 2, "nest": 0.5}, creatures: {"brute": 1.2}),
            "swamp": (name: "Marais", rooms: {"nest": 3, "treasure": 0.5, "kitchen": 0.5}, creatures: {"lookout": 2}, chests: 0.7),
        },
        seasons: {
            "spring": (name: "Printemps", rooms: {"nest": 1.5}),
            "summer": (name: "Été", creatures: {"lookout": 1.5}),
            "autumn": (name: "Automne", rooms: {"storage": 2, "kitchen": 1.5}, chests: 1.3),
            "winter": (name: "Hiver", rooms: {"barracks": 2, "storage": 0.5}, creature_factor: 1.1, chests: 0.8),
        },
        // Menace de 1 (faible) à 5 (extrême) ; default_threat quand la mission n'en dit rien.
        default_threat: 3,
        threats: {
            "1": (name: "Menace faible", creature_factor: 0.5, branches: -1),
            "2": (name: "Menace modérée", creature_factor: 0.75),
            "3": (name: "Menace normale"),
            "4": (name: "Menace forte", creature_factor: 1.25, branches: 1),
            "5": (name: "Menace extrême", creature_factor: 1.5, branches: 1, main_path: 1, levels: 1),
        },
        // Nombre d'ennemis (faible / moyen / beaucoup) ; default_density quand la mission n'en dit rien.
        default_density: "low",
        densities: {
            "low": (name: "Ennemis : peu"),
            "medium": (name: "Ennemis : moyen", creature_factor: 2),
            "high": (name: "Ennemis : beaucoup", creature_factor: 3.5),
        },
        objectives: {
            "loot": (name: "Piller", rooms: {"treasure": 3, "storage": 1.5}, chests: 1.3),
            "clear": (name: "Nettoyer", rooms: {"nest": 2}, creature_factor: 1.2),
            "rescue": (name: "Sauver", rooms: {"guardRoom": 1.5, "barracks": 1.5}),
            "explore": (name: "Explorer", main_path: 1, levels: 1, creature_factor: 0.8),
            // Le boss suffit : un peu moins de monde en chemin.
            "bossLair": (name: "Antre de boss", creature_factor: 0.8),
        },
    ),
    // Clés des portes verrouillées (tâche G.8) : une différente par porte, dans l'ordre des verrous (au moins autant
    // que le plus grand nombre de verrous de `sizes`). item : la clé de Veloren que la serrure consomme ; loot : la
    // table de butin du coffre qui la garde, posé où le générateur a mis la clé (assets/common/loot_tables/icebreaker).
    keys: [
        (item: "common.items.keys.bone_key", loot: "common.loot_tables.icebreaker.cle_bone"),
        (item: "common.items.keys.glass_key", loot: "common.loot_tables.icebreaker.cle_glass"),
        (item: "common.items.keys.vampire_key", loot: "common.loot_tables.icebreaker.cle_vampire"),
        (item: "common.items.keys.haniwa_key", loot: "common.loot_tables.icebreaker.cle_haniwa"),
    ],
    // Créatures endormies (tâche G.9, salles `awake: false`) : couchées, immobiles, des « Zzz » au-dessus d'elles.
    // Elles se réveillent si on les frappe, si un combat s'entend près d'elles, ou si un joueur approche à moins de
    // wake_radius blocs (wake_radius_sneaking s'il avance accroupi) ; une créature qui se réveille réveille les
    // endormies à moins de alert_radius blocs. zzz_interval : secondes entre deux « Zzz ».
    sleep: (
        wake_radius: 6.0,
        wake_radius_sneaking: 2.5,
        alert_radius: 12.0,
        zzz_interval: 5.0,
    ),
    // Décor par rôle de salle (F.6) : des sprites de Veloren (leur nom) ; at : wall (contre un mur, tourné vers la
    // salle), center (au milieu d'une case, around : un sprite sur les quatre blocs autour, des chaises) ou scatter
    // (semé sur les blocs de sol, chance par bloc) ; count : nombre par salle (wall, center). Jamais sur une case
    // occupée (créature, coffre, clé, lumière), ni à côté d'une porte, d'un escalier ou d'un trou.
    decor: (
        // Icebreaker : le décor dessiné dans le plan des salles (`docs/icebreaker/design/donjon.md`, « Décor des
        // salles »). Un symbole = un sprite, posé là où il est dessiné, sur un sol libre : wall = contre le mur voisin
        // (au milieu de la case s'il n'y en a pas), center = au milieu de la case (around : un sprite sur les quatre
        // blocs autour). Les symboles possibles : plan.rs, DECOR_SYMBOLS.
        symbols: {
            '=': (sprite: "DiningtableWoodWoodlandRound", at: center, around: Some("ChairWoodWoodland")), // table et chaises
            '&': (sprite: "Bedroll", at: wall),                // couchage
            '!': (sprite: "Candle", at: wall),                 // bougie
            '?': (sprite: "Shelf", at: wall),                  // étagère
            '|': (sprite: "Barrel", at: wall),                 // tonneau
            '"': (sprite: "CrateBlock", at: wall),             // caisse
            '\'': (sprite: "SackLeatherM", at: wall),          // sac
            '-': (sprite: "Bones", at: center),                // ossements
            ':': (sprite: "Hay", at: center),                  // paille
            '1': (sprite: "BonfireMLit", at: center),          // feu de camp
            '2': (sprite: "CookingPot", at: center),           // marmite
            '3': (sprite: "Cauldron", at: wall),               // chaudron
            '4': (sprite: "TrophyframeWoodDeer", at: wall),    // trophée
            '5': (sprite: "Helm", at: wall),                   // heaume
            '6': (sprite: "DoorBars", at: wall),               // barreaux
            '7': (sprite: "MetalChain", at: wall),             // chaînes
            '8': (sprite: "MagicalSeal", at: center),          // sceau magique
            '9': (sprite: "Gravestone", at: wall),             // pierre tombale
            '0': (sprite: "Orb", at: center),                  // orbe
            '`': (sprite: "EnsnaringWeb", at: center),         // toile
            ',': (sprite: "CaveMushroom", at: center),         // champignons
            '/': (sprite: "Anvil", at: center),                // enclume
            '\\': (sprite: "BarrelWoodWater", at: wall),       // tonneau d'eau
            '(': (sprite: "WallSconce", at: wall),             // applique
            ')': (sprite: "Bell", at: center),                 // cloche
            '{': (sprite: "CarpenterToolsWall", at: wall),     // outils
            '}': (sprite: "DungeonWallDecor", at: wall),       // tenture
        },
        roles: {
            "entrance": [(sprite: "Crate", at: wall, count: (1, 2)), (sprite: "Barrel", at: wall, count: (0, 1))],
            "hall": [
                (sprite: "Barrel", at: wall, count: (0, 2)),
                (sprite: "Stones", at: scatter, chance: 0.01),
                (sprite: "Bones", at: scatter, chance: 0.005),
            ],
            "guardRoom": [
                (sprite: "DiningtableWoodWoodlandRound", at: center, count: (1, 1), around: Some("ChairWoodWoodland")),
                (sprite: "CarpenterToolsWall", at: wall, count: (1, 2)),
                (sprite: "Helm", at: wall, count: (0, 1)),
                (sprite: "Barrel", at: wall, count: (0, 2)),
            ],
            "barracks": [
                (sprite: "Bedroll", at: wall, count: (4, 8)),
                (sprite: "CrateBlock", at: wall, count: (1, 2)),
                (sprite: "Helm", at: wall, count: (0, 2)),
            ],
            "storage": [
                (sprite: "Barrel", at: wall, count: (3, 6)),
                (sprite: "CrateBlock", at: wall, count: (2, 4)),
                (sprite: "Shelf", at: wall, count: (1, 3)),
                (sprite: "SackLeatherM", at: wall, count: (1, 3)),
                (sprite: "BasketWovenL", at: wall, count: (0, 2)),
                (sprite: "Hay", at: scatter, chance: 0.02),
            ],
            "kitchen": [
                (sprite: "CookingPot", at: center, count: (1, 1)),
                (sprite: "Cauldron", at: wall, count: (1, 1)),
                (sprite: "Barrel", at: wall, count: (2, 4)),
                (sprite: "BarrelWoodWater", at: wall, count: (0, 1)),
                (sprite: "JugClayM", at: wall, count: (0, 2)),
                (sprite: "DiningtableWoodWoodlandRound", at: center, count: (1, 2), around: Some("ChairWoodWoodland")),
            ],
            "nest": [
                (sprite: "Bones", at: scatter, chance: 0.06),
                (sprite: "EnsnaringWeb", at: scatter, chance: 0.03),
                (sprite: "CaveMushroom", at: scatter, chance: 0.03),
                (sprite: "Mushroom", at: scatter, chance: 0.02),
            ],
            "treasure": [
                (sprite: "Candle", at: wall, count: (2, 4)),
                (sprite: "Crate", at: wall, count: (1, 2)),
                (sprite: "DungeonWallDecor", at: wall, count: (1, 2)),
                (sprite: "Orb", at: center, count: (0, 1)),
            ],
            "chiefLair": [
                (sprite: "BonfireMLit", at: center, count: (1, 1)),
                (sprite: "TrophyframeWoodDeer", at: wall, count: (1, 2)),
                (sprite: "Helm", at: wall, count: (1, 2)),
                (sprite: "Barrel", at: wall, count: (1, 2)),
                (sprite: "Bones", at: scatter, chance: 0.03),
            ],
            "prison": [
                (sprite: "DoorBars", at: wall, count: (2, 4)),
                (sprite: "MetalChain", at: wall, count: (2, 4)),
                (sprite: "Bones", at: scatter, chance: 0.02),
                (sprite: "Hay", at: scatter, chance: 0.02),
            ],
            "vault": [
                (sprite: "Candle", at: wall, count: (2, 3)),
                (sprite: "Crate", at: wall, count: (2, 4)),
                (sprite: "Barrel", at: wall, count: (1, 2)),
                (sprite: "Orb", at: center, count: (0, 1)),
            ],
            "sanctum": [
                (sprite: "Candle", at: wall, count: (3, 6)),
                (sprite: "MagicalSeal", at: center, count: (1, 1)),
                (sprite: "Gravestone", at: wall, count: (1, 3)),
                (sprite: "Bones", at: scatter, chance: 0.01),
            ],
            "bossLair": [
                (sprite: "BonfireMLit", at: center, count: (0, 1)),
                (sprite: "IronSpike", at: wall, count: (0, 3)),
                (sprite: "Bones", at: scatter, chance: 0.04),
            ],
        },
        corridors: [
            (sprite: "Barrel", at: wall, count: (0, 2)),
            (sprite: "Bones", at: scatter, chance: 0.004),
            (sprite: "Stones", at: scatter, chance: 0.006),
            (sprite: "EnsnaringWeb", at: scatter, chance: 0.004),
        ],
    ),
    // Éclairage selon les habitants (tâche G.10) : chance qu'une case de sol libre porte une lumière, selon le rôle de
    // la salle (default pour les autres rôles) ; corridors : hors des salles ; empty_factor : facteur pour une salle
    // sans créature ; wall_torches : part des lumières en torches au mur (case contre un mur), le reste en braseros.
    // Les bêtes des nids vivent dans le noir ; gardes, cuisiniers et chef s'éclairent.
    lighting: (
        roles: {
            "entrance": 0.3,
            "guardRoom": 0.35,
            "barracks": 0.12,
            "kitchen": 0.4,
            "storage": 0.15,
            "nest": 0.0,
            "treasure": 0.25,
            "chiefLair": 0.4,
            "prison": 0.1,
            "vault": 0.2,
            "sanctum": 0.35,
            "bossLair": 0.3,
        },
        default: 0.15,
        corridors: 0.06,
        empty_factor: 0.3,
        wall_torches: 0.5,
    ),
    // Place dans le monde (F.8) : un donjon qui dépasse le bord du monde ne se finit pas (les tronçons au-delà ne
    // sont jamais générés). entrance_margin : tronçons (32 blocs) au moins entre l'entrée et le bord ; un donjon moyen
    // s'étend jusqu'à ~23 tronçons de son entrée (90 % sous 17), un grand jusqu'à ~27. edge_margin : tronçons gardés
    // entre le donjon et le bord ; un donjon trop près est refait avec une autre graine, fit_tries fois au plus.
    placement: (
        entrance_margin: 16,
        edge_margin: 1,
        fit_tries: 20,
        // Icebreaker I.11 : tronçons réservés autour de l'entrée, de chaque côté ; un donjon refait pour une expédition
        // (I.12) doit y tenir (un moyen sur deux tient sous 13, un grand sous 16) : refait sinon, comme au bord.
        // Plus grand : un donjon plus libre, mais plus de tronçons à dessiner et une zone fermée plus large.
        emprise: 14,
        // Icebreaker F.31 : le donjon est tout entier sous le sol, sans bouche en surface (on arrive dans l'abri) :
        // blocs de roche au moins entre le plafond de l'étage le plus haut et le sol le plus bas au-dessus du donjon.
        profondeur: 12,
    ),
    // Icebreaker F.32 : l'abri, la salle sûre où l'on arrive (salle `abri.txt`, rôle safeRoom) : aucune créature à moins
    // de `calme` cases de l'arrivée (couloirs compris, sur son étage et ceux d'à côté), comme dans la grotte.
    abri: (calme: 4),
)
