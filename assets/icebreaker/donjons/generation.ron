// Icebreaker : réglages du générateur de donjon (lieu « Genere », docs/icebreaker/PLAN.md, jalon G).
// Repris de game/data/dungeons/generation.json du projet Icebreaker (règles : docs/icebreaker/design/generation.md).
// Plages (min, max) inclusives. Les nombres de branches, verrous, boucles et chutes sont des maximums visés : le
// générateur en place moins s'il ne trouve pas d'endroit qui garde le donjon finissable.
(
    // Passage du plan aux blocs.
    render: (
        cell_size: 5,      // blocs par case (horizontalement)
        level_height: 5,   // blocs par étage, sol compris ; au plus cell_size (escalier : une marche par bloc)
        tunnel_cells: 4,   // cases du tunnel qui descend de la surface à la salle d'entrée
        wall_color: (92, 86, 80),
        floor_color: (70, 62, 55),
    ),

    // Graphe de mission (tâche G.3), par taille de donjon.
    sizes: {
        "small": (
            main_path: (4, 5),      // salles du chemin principal, entrée et objectif compris
            levels: (1, 2),         // étages traversés
            branches: (1, 2),       // culs-de-sac (dont ceux qui cachent une clé)
            branch_length: (1, 1),
            max_branches_per_room: 2,   // branches au plus par salle (ses portes sont limitées)
            locks: (0, 1),
            loops: (0, 1),
            drops: (0, 1),          // chutes à sens unique vers plus bas (raccourcis)
        ),
        "medium": (
            main_path: (5, 7),
            levels: (2, 3),
            branches: (2, 4),
            branch_length: (1, 2),
            max_branches_per_room: 2,
            locks: (1, 1),
            loops: (1, 1),
            drops: (0, 1),
        ),
        "large": (
            main_path: (7, 10),
            levels: (2, 4),
            branches: (3, 6),
            branch_length: (1, 3),
            max_branches_per_room: 2,
            locks: (1, 2),
            loops: (1, 2),
            drops: (1, 2),
        ),
    },
    // Rôles possibles des salles des branches, tirés au hasard parmi ceux qui respectent les règles ci-dessous
    // (répéter un rôle le rend plus fréquent).
    branch_roles: ["guardRoom", "barracks", "barracks", "storage", "storage", "kitchen", "kitchen", "nest", "nest", "treasure"],
    // Règles de cohérence : « des habitants crédibles ».
    rules: (
        guard_before_locks: true,   // la salle avant chaque porte fermée est une salle de garde
        fallback: "guardRoom",      // rôle pris quand aucun autre ne respecte les règles
        // next_to : rôles possibles de la salle d'où part la branche ; min_distance_from_main_path : 1 = accrochée au
        // chemin principal, 2 = au moins une salle entre les deux ; max : salles de ce rôle au plus par donjon.
        roles: {
            "barracks": (next_to: ["entrance", "guardRoom"], max: Some(2)),
            "storage": (next_to: ["kitchen"], max: Some(2)),
            "kitchen": (max: Some(1)),
            "nest": (min_distance_from_main_path: 2, max: Some(2)),
            "treasure": (max: Some(1)),
        },
    ),
    // Salle au bout du chemin principal selon l'objectif de la mission.
    goal_roles: {
        "killChief": "chiefLair",
        "rescue": "prison",
        "loot": "vault",
        "clear": "nest",
        "explore": "sanctum",
        "bossLair": "bossLair",
    },
    // Assemblage (tâche G.4) : placement des salles et creusement des couloirs.
    assembly: (
        attempts: 20,           // tentatives complètes avant d'abandonner
        placement_tries: 40,    // essais pour placer une salle
        extra_passage_tries: 8, // essais pour une boucle ou une chute (abandonnée sinon)
        spacing: (1, 5),        // cases entre une porte et la salle suivante
        search_limit: 3000,     // cases examinées par recherche de couloir
        margin: 6,              // marge autour du donjon où un couloir peut passer
    ),
    // Habitants et butin selon le rôle de la salle (tâche G.5). creatures : nombre par sorte (brute, archer, lookout,
    // chief, boss) ; chests : coffres ; awake : éveillées (false : endormies, voir `sleep`).
    // Rôle absent : salle vide. Le chef garde toujours la salle de l'objectif.
    population: {
        "hall": (creatures: {"lookout": (0, 1)}),
        "guardRoom": (creatures: {"brute": (1, 2), "archer": (0, 1)}),
        "barracks": (creatures: {"brute": (2, 3)}, awake: false),
        "storage": (creatures: {"lookout": (0, 1)}, chests: (1, 2)),
        "kitchen": (creatures: {"brute": (0, 1), "lookout": (0, 1)}),
        "nest": (creatures: {"brute": (2, 3)}, awake: false),
        "treasure": (creatures: {"brute": (1, 1), "archer": (0, 1)}, chests: (2, 3)),
        "chiefLair": (creatures: {"chief": (1, 1), "archer": (1, 2)}),
        "prison": (creatures: {"brute": (1, 2)}),
        "vault": (creatures: {"brute": (1, 2), "archer": (0, 1)}, chests: (3, 4)),
        "sanctum": (creatures: {"archer": (1, 2)}, chests: (1, 1)),
        "bossLair": (creatures: {"boss": (1, 1)}, chests: (1, 2)),
    },
    // Qui habite le donjon : pour chaque sorte des plans, des créatures de Veloren (tirées au hasard dans la liste) ;
    // chest : le coffre (son butin vient de Veloren, DungeonChest0 = gnarlings, 1 = adlets, 5 = cultistes).
    default_faction: "gnarling",
    factions: {
        "gnarling": (
            creatures: {
                "brute": ["common.entity.dungeon.gnarling.logger"],
                "archer": ["common.entity.dungeon.gnarling.stalker"],
                "lookout": ["common.entity.dungeon.gnarling.mugger"],
                "chief": ["common.entity.dungeon.gnarling.chieftain"],
                "boss": ["common.entity.dungeon.gnarling.harvester"],
            },
            chest: "DungeonChest0",
        ),
        "adlet": (
            creatures: {
                "brute": ["common.entity.dungeon.adlet.icepicker"],
                "archer": ["common.entity.dungeon.adlet.hunter"],
                "lookout": ["common.entity.dungeon.adlet.tracker"],
                "chief": ["common.entity.dungeon.adlet.elder"],
                "boss": ["common.entity.dungeon.adlet.yeti"],
            },
            chest: "DungeonChest1",
        ),
        "cultist": (
            creatures: {
                "brute": ["common.entity.dungeon.cultist.husk_brute"],
                "archer": ["common.entity.dungeon.cultist.warlock"],
                "lookout": ["common.entity.dungeon.cultist.cultist", "common.entity.dungeon.cultist.husk"],
                "chief": ["common.entity.dungeon.cultist.warlord"],
                "boss": ["common.entity.dungeon.cultist.mindflayer"],
            },
            chest: "DungeonChest5",
        ),
    },
    // Paramètres de la mission (tâche G.6) : région, saison, menace, nombre d'ennemis et objectif changent le donjon.
    // Valeurs du projet Icebreaker, à régler en jouant. Les écarts s'ajoutent, les facteurs se multiplient :
    //   main_path, levels, branches : salles du chemin principal, étages, branches en plus (ou en moins) ;
    //   rooms : facteur du poids d'un rôle des branches (0 : jamais) ;
    //   creature_factor : facteur du nombre de créatures (le chef et le boss restent uniques) ; creatures : par sorte ;
    //   chests : facteur du nombre de coffres. name : affiché dans le résumé du donjon (journal du serveur).
    parameters: (
        regions: {
            "forest": (name: "Forêt", rooms: {"nest": 2, "kitchen": 1.5}, creatures: {"archer": 1.5}),
            "mountain": (name: "Montagne", levels: 1, main_path: 1, rooms: {"barracks": 2, "nest": 0.5}, creatures: {"brute": 1.2}),
            "swamp": (name: "Marais", rooms: {"nest": 3, "treasure": 0.5, "kitchen": 0.5}, creatures: {"lookout": 2}, chests: 0.7),
        },
        seasons: {
            "spring": (name: "Printemps", rooms: {"nest": 1.5}),
            "summer": (name: "Été", creatures: {"lookout": 1.5}),
            "autumn": (name: "Automne", rooms: {"storage": 2, "kitchen": 1.5}, chests: 1.3),
            "winter": (name: "Hiver", rooms: {"barracks": 2, "storage": 0.5}, creature_factor: 1.1, chests: 0.8),
        },
        // Menace de 1 (faible) à 5 (extrême) ; default_threat quand la mission n'en dit rien.
        default_threat: 3,
        threats: {
            "1": (name: "Menace faible", creature_factor: 0.5, branches: -1),
            "2": (name: "Menace modérée", creature_factor: 0.75),
            "3": (name: "Menace normale"),
            "4": (name: "Menace forte", creature_factor: 1.25, branches: 1),
            "5": (name: "Menace extrême", creature_factor: 1.5, branches: 1, main_path: 1, levels: 1),
        },
        // Nombre d'ennemis (faible / moyen / beaucoup) ; default_density quand la mission n'en dit rien.
        default_density: "low",
        densities: {
            "low": (name: "Ennemis : peu"),
            "medium": (name: "Ennemis : moyen", creature_factor: 2),
            "high": (name: "Ennemis : beaucoup", creature_factor: 3.5),
        },
        objectives: {
            "loot": (name: "Piller", rooms: {"treasure": 3, "storage": 1.5}, chests: 1.3),
            "clear": (name: "Nettoyer", rooms: {"nest": 2}, creature_factor: 1.2),
            "rescue": (name: "Sauver", rooms: {"guardRoom": 1.5, "barracks": 1.5}),
            "explore": (name: "Explorer", main_path: 1, levels: 1, creature_factor: 0.8),
            // Le boss suffit : un peu moins de monde en chemin.
            "bossLair": (name: "Antre de boss", creature_factor: 0.8),
        },
    ),
    // Clés des portes verrouillées (tâche G.8) : une différente par porte, dans l'ordre des verrous (au moins autant
    // que le plus grand nombre de verrous de `sizes`). item : la clé de Veloren que la serrure consomme ; loot : la
    // table de butin du coffre qui la garde, posé où le générateur a mis la clé (assets/common/loot_tables/icebreaker).
    keys: [
        (item: "common.items.keys.bone_key", loot: "common.loot_tables.icebreaker.cle_bone"),
        (item: "common.items.keys.glass_key", loot: "common.loot_tables.icebreaker.cle_glass"),
        (item: "common.items.keys.vampire_key", loot: "common.loot_tables.icebreaker.cle_vampire"),
        (item: "common.items.keys.haniwa_key", loot: "common.loot_tables.icebreaker.cle_haniwa"),
    ],
    // Créatures endormies (tâche G.9, salles `awake: false`) : couchées, immobiles, des « Zzz » au-dessus d'elles.
    // Elles se réveillent si on les frappe, si un combat s'entend près d'elles, ou si un joueur approche à moins de
    // wake_radius blocs (wake_radius_sneaking s'il avance accroupi) ; une créature qui se réveille réveille les
    // endormies à moins de alert_radius blocs. zzz_interval : secondes entre deux « Zzz ».
    sleep: (
        wake_radius: 6.0,
        wake_radius_sneaking: 2.5,
        alert_radius: 12.0,
        zzz_interval: 5.0,
    ),
    // Éclairage selon les habitants (tâche G.10) : chance qu'une case de sol libre porte une lumière, selon le rôle de
    // la salle (default pour les autres rôles) ; corridors : hors des salles ; empty_factor : facteur pour une salle
    // sans créature ; wall_torches : part des lumières en torches au mur (case contre un mur), le reste en braseros.
    // Les bêtes des nids vivent dans le noir ; gardes, cuisiniers et chef s'éclairent.
    lighting: (
        roles: {
            "entrance": 0.3,
            "guardRoom": 0.35,
            "barracks": 0.12,
            "kitchen": 0.4,
            "storage": 0.15,
            "nest": 0.0,
            "treasure": 0.25,
            "chiefLair": 0.4,
            "prison": 0.1,
            "vault": 0.2,
            "sanctum": 0.35,
            "bossLair": 0.3,
        },
        default: 0.15,
        corridors: 0.06,
        empty_factor: 0.3,
        wall_torches: 0.5,
    ),
)
