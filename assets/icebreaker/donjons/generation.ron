// Icebreaker : réglages du générateur de donjon (lieu « Genere », docs/icebreaker/PLAN.md, jalon G).
// Repris de game/data/dungeons/generation.json du projet Icebreaker (règles : docs/icebreaker/design/generation.md).
// Plages (min, max) inclusives. Les nombres de branches, verrous, boucles et chutes sont des maximums visés : le
// générateur en place moins s'il ne trouve pas d'endroit qui garde le donjon finissable.
(
    // Passage du plan aux blocs.
    render: (
        cell_size: 5,      // blocs par case (horizontalement)
        level_height: 5,   // blocs par étage, sol compris ; au plus cell_size (escalier : une marche par bloc)
        tunnel_cells: 4,   // cases du tunnel qui descend de la surface à la salle d'entrée
        wall_color: (92, 86, 80),
        floor_color: (70, 62, 55),
    ),

    // Graphe de mission (tâche G.3), par taille de donjon.
    sizes: {
        "small": (
            main_path: (4, 5),      // salles du chemin principal, entrée et objectif compris
            levels: (1, 2),         // étages traversés
            branches: (1, 2),       // culs-de-sac (dont ceux qui cachent une clé)
            branch_length: (1, 1),
            max_branches_per_room: 2,   // branches au plus par salle (ses portes sont limitées)
            locks: (0, 1),
            loops: (0, 1),
            drops: (0, 1),          // chutes à sens unique vers plus bas (raccourcis)
        ),
        "medium": (
            main_path: (5, 7),
            levels: (2, 3),
            branches: (2, 4),
            branch_length: (1, 2),
            max_branches_per_room: 2,
            locks: (1, 1),
            loops: (1, 1),
            drops: (0, 1),
        ),
        "large": (
            main_path: (7, 10),
            levels: (2, 4),
            branches: (3, 6),
            branch_length: (1, 3),
            max_branches_per_room: 2,
            locks: (1, 2),
            loops: (1, 2),
            drops: (1, 2),
        ),
    },
    // Rôles possibles des salles des branches, tirés au hasard parmi ceux qui respectent les règles ci-dessous
    // (répéter un rôle le rend plus fréquent).
    branch_roles: ["guardRoom", "barracks", "barracks", "storage", "storage", "kitchen", "kitchen", "nest", "nest", "treasure"],
    // Règles de cohérence : « des habitants crédibles ».
    rules: (
        guard_before_locks: true,   // la salle avant chaque porte fermée est une salle de garde
        fallback: "guardRoom",      // rôle pris quand aucun autre ne respecte les règles
        // next_to : rôles possibles de la salle d'où part la branche ; min_distance_from_main_path : 1 = accrochée au
        // chemin principal, 2 = au moins une salle entre les deux ; max : salles de ce rôle au plus par donjon.
        roles: {
            "barracks": (next_to: ["entrance", "guardRoom"], max: Some(2)),
            "storage": (next_to: ["kitchen"], max: Some(2)),
            "kitchen": (max: Some(1)),
            "nest": (min_distance_from_main_path: 2, max: Some(2)),
            "treasure": (max: Some(1)),
        },
    ),
    // Salle au bout du chemin principal selon l'objectif de la mission.
    goal_roles: {
        "killChief": "chiefLair",
        "rescue": "prison",
        "loot": "vault",
        "clear": "nest",
        "explore": "sanctum",
        "bossLair": "bossLair",
    },
    // Assemblage (tâche G.4) : placement des salles et creusement des couloirs.
    assembly: (
        attempts: 20,           // tentatives complètes avant d'abandonner
        placement_tries: 40,    // essais pour placer une salle
        extra_passage_tries: 8, // essais pour une boucle ou une chute (abandonnée sinon)
        spacing: (1, 5),        // cases entre une porte et la salle suivante
        search_limit: 3000,     // cases examinées par recherche de couloir
        margin: 6,              // marge autour du donjon où un couloir peut passer
    ),
)
