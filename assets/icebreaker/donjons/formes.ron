#![enable(implicit_some)]
// Icebreaker F.33 : la forme du donjon généré, comme les profils des grottes (grottes/formes.ron). Chaque profil change
// quelques réglages de generation.ron : le graphe (pour toutes les tailles : main_path, levels, branches,
// branch_length, locks, loops, drops), l'écart entre les salles (spacing) et la roche au-dessus (profondeur) ; ce
// qu'il ne dit pas garde sa valeur. F.46 à F.48, à la manière de donjon.bin.sh : la silhouette du plan (silhouette,
// etendue), les couloirs (sinuosite, impasses), les salles (collees, formes_part, salle_largeur, salle_profondeur).
// F.52 : le labyrinthe qui remplit le vide de la forme (remplissage, boucles_labyrinthe, elagage),
// F.53 : les salles hors mission posées dans le vide (salles_en_plus). F.55, F.56 : le relief
// (escaliers_z, tours, tour_etages, tour_largeur, tour_vide).

// La liste des réglages et leurs bornes : `CHAMPS` de world/src/icebreaker/dungeon/formes.rs. La graine d'un donjon en tire un selon les poids (poids 0 : jamais tiré, seulement
// choisi) ; ICEBREAKER_DONJON_PROFIL (-Profil du lanceur) en demande un ; en campagne, l'équipe le choisit au
// panneau Départ ou par `/expedition 3 <profil>`.
// Pour régler : `.\icebreaker.ps1 donjon-atelier` ouvre l'atelier ; « Enregistrer le preset » écrit ici le profil.
(
    profils: {
        // F.59 (Flo, 2026-11-23) : six formes, chacune vraiment différente, toutes tirées par la graine.
        // Trois silhouettes :
        // la croix : deux longues ailes qui se croisent à l'entrée ; presque à plat, sans boucle ni chute : on va au
        // bout d'une aile et on revient ; ses rares descentes par un escalier en Z.
        "croix": (
            poids: 1.0,
            forme: (levels: (1, 2), loops: (0, 0), drops: (0, 0), silhouette: Croix, etendue: 48, escaliers_z: 40),
        ),
        // la forteresse : un anneau de salles carrées collées l'une à l'autre, presque sans couloir, sur un seul
        // étage, avec des portes à clé : on fait le tour.
        "forteresse": (
            poids: 1.0,
            forme: (levels: (1, 1), locks: (1, 2), drops: (0, 0), spacing: (1, 1), collees: 85, formes_part: 20, silhouette: Couronne, etendue: 38),
        ),
        // le rond : tout tient dans un cercle serré, sur plusieurs étages, plein de boucles et de salles à forme
        // tirée (rondes, en croix, en grotte) reliées par des escaliers en Z.
        "rond": (
            poids: 1.0,
            forme: (levels: (2, 3), loops: (3, 4), formes_part: 80, silhouette: Rond, etendue: 30, escaliers_z: 50),
        ),
        // Le labyrinthe (dedale et labyrinthe réunis) : un carré dont tout le vide est un labyrinthe, à la manière de
        // donjon.bin.sh ; des salles écartées, des couloirs qui serpentent, des salles hors mission à y trouver ; peu
        // d'étages, chacun étant rempli.
        "labyrinthe": (
            poids: 1.0,
            forme: (levels: (1, 2), loops: (2, 4), spacing: (2, 4), sinuosite: 80, silhouette: Carre, etendue: 32, remplissage: 100, boucles_labyrinthe: 4, salles_en_plus: (3, 5)),
        ),
        // La tour (tours et profond réunis) : étroite et très profonde ; on descend par de grandes tours à colimaçon
        // (5 cases de large, le plus souvent un vide au milieu), des escaliers en Z et des chutes ; salles serrées,
        // souvent collées.
        "tour": (
            poids: 1.0,
            forme: (levels: (4, 5), drops: (1, 2), spacing: (1, 2), collees: 40, silhouette: Carre, etendue: 20, escaliers_z: 50, tours: 80, tour_etages: (2, 4), tour_largeur: 5, tour_vide: 70, profondeur: 20),
        ),
        // Le plat (plat et standard réunis) : le donjon ordinaire, sans silhouette, sur un seul étage et sans chute :
        // tout se joue à plat.
        "plat": (
            poids: 1.0,
            forme: (levels: (1, 1), drops: (0, 0)),
        ),
    },
)
