#![enable(implicit_some)]
// Icebreaker F.33 : la forme du donjon généré, comme les profils des grottes (grottes/formes.ron). Chaque profil change
// quelques réglages de generation.ron : le graphe (pour toutes les tailles : main_path, levels, branches,
// branch_length, locks, loops, drops), l'écart entre les salles (spacing) et la roche au-dessus (profondeur) ; ce
// qu'il ne dit pas garde sa valeur. F.46 à F.48, à la manière de donjon.bin.sh : la silhouette du plan (silhouette,
// etendue), les couloirs (sinuosite, impasses), les salles (collees, formes_part, salle_largeur, salle_profondeur).
// F.52 : le labyrinthe qui remplit le vide de la forme (remplissage, boucles_labyrinthe, elagage),
// F.53 : les salles hors mission posées dans le vide (salles_en_plus). F.55, F.56 : le relief
// (escaliers_z, tours, tour_etages, tour_largeur, tour_vide).

// La liste des réglages et leurs bornes : `CHAMPS` de world/src/icebreaker/dungeon/formes.rs. La graine d'un donjon en tire un selon les poids (poids 0 : jamais tiré, seulement
// choisi) ; ICEBREAKER_DONJON_PROFIL (-Profil du lanceur) en demande un ; en campagne, l'équipe le choisit au
// panneau Départ ou par `/expedition 3 <profil>`.
// Pour régler : `.\icebreaker.ps1 donjon-atelier` ouvre l'atelier ; « Enregistrer le preset » écrit ici le profil.
(
    profils: {
        // Les tailles de generation.ron telles quelles.
        "standard": (
            poids: 2.0,
            forme: (),
        ),
        // F.49 : une croix, peu d'étages : deux longues ailes qui se croisent à l'entrée. F.54 : un peu de labyrinthe
        // et quelques salles hors mission au bout des ailes.
        "croix": (
            poids: 1.0,
            forme: (levels: (1, 2), drops: (0, 0), silhouette: Croix, etendue: 42, remplissage: 40, salles_en_plus: (2, 4), escaliers_z: 40),
        ),
        // F.49 : tout tient dans un cercle serré, avec des boucles et beaucoup de salles à forme tirée.
        "rond": (
            poids: 1.0,
            forme: (levels: (2, 3), loops: (2, 3), formes_part: 70, silhouette: Rond, etendue: 30, remplissage: 60, salles_en_plus: (2, 3), escaliers_z: 30, tours: 30, tour_etages: (2, 2)),
        ),
        // F.49 : un anneau de salles collées l'une à l'autre, presque sans couloir : on fait le tour.
        "forteresse": (
            poids: 1.0,
            forme: (levels: (1, 2), spacing: (1, 2), collees: 70, silhouette: Couronne, etendue: 34, remplissage: 30),
        ),
        // F.49 : des salles écartées, reliées par des couloirs qui serpentent, avec des boucles ; le tout dans un
        // carré. F.54 : le carré est resserré et tout son vide est un labyrinthe (à la manière de donjon.bin.sh), avec
        // des salles hors mission à y trouver.
        "dedale": (
            poids: 1.0,
            forme: (loops: (2, 4), spacing: (3, 6), sinuosite: 80, silhouette: Carre, etendue: 28, remplissage: 100, boucles_labyrinthe: 4, salles_en_plus: (3, 5), escaliers_z: 30),
        ),
        // F.57 : peu de salles, très profond : on descend par de grandes tours à colimaçon (5 cases de large, le plus
        // souvent un vide au milieu) et des escaliers en Z ; quelques chutes pour couper.
        "tours": (
            poids: 1.0,
            forme: (main_path: (6, 8), levels: (3, 4), drops: (1, 2), escaliers_z: 40, tours: 80, tour_etages: (2, 4), tour_largeur: 5, tour_vide: 70, profondeur: 16),
        ),
        // Un seul étage, sans chute : tout se joue à plat.
        "plat": (
            poids: 0.0,
            forme: (levels: (1, 1), drops: (0, 0)),
        ),
        // Une longue descente : beaucoup d'étages et de chutes. F.57 : par des escaliers en Z et quelques tours.
        "profond": (
            poids: 0.0,
            forme: (main_path: (9, 11), levels: (4, 5), drops: (1, 2), escaliers_z: 50, tours: 30, tour_etages: (2, 3), profondeur: 20),
        ),
        // Beaucoup de branches et de boucles, des salles plus écartées. F.54 : sans silhouette, le labyrinthe remplit
        // le rectangle que prend le donjon.
        "labyrinthe": (
            poids: 0.0,
            forme: (branches: (6, 9), loops: (2, 3), spacing: (2, 4), remplissage: 100, boucles_labyrinthe: 3),
        ),
    },
)
