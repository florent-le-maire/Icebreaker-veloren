// Icebreaker : le lieu d'entraînement (jalon O, `common/src/icebreaker_arene.rs`,
// `docs/icebreaker/PLAN-ENTRAINEMENT.md`). Un plateau nivelé dans un monde sans site : l'arène est un disque au
// milieu, marqué par un anneau au sol ; l'entrée est sur le plateau, hors du disque.
(
    // Rayon de l'arène (en blocs) : le disque où viennent les ennemis.
    rayon: 24.0,
    // Rayon du plateau nivelé ; les joueurs ne le quittent pas.
    rayon_terrain: 48.0,
    // Jusqu'où chercher le plateau depuis le centre de la carte (en tronçons de 32 blocs) : le plus plat est pris.
    recherche: 10,
    // Blocs d'air au-dessus du plateau (arbres et reliefs coupés).
    hauteur_libre: 60,
    // Blocs de terre posés sous le plateau, là où le terrain est plus bas.
    profondeur: 12,
    // Couleur du sol du plateau, et de l'anneau qui marque le bord de l'arène (rouge, vert, bleu).
    couleur_sol: (96, 124, 62),
    couleur_bord: (176, 150, 96),
    // L'entrée (apparition et réapparition), depuis le centre de l'arène (x vers l'est, y vers le nord).
    entree: (0.0, -36.0),
    // La classe d'un personnage qui arrive sans arme d'une de nos classes en mains (`classes.ron`).
    classe_par_defaut: "guerrier",
    // Le niveau de toutes les compétences à l'arrivée et après un changement de classe (1 à 5).
    niveau: 1,
    // Où les ennemis viennent : sur un cercle de ce rayon autour du centre de l'arène (en blocs).
    rayon_apparition: 6.0,
    // Combien d'ennemis ou d'alliés une commande fait venir au plus, et combien l'arène en porte en tout.
    max_par_appel: 10,
    max_en_piste: 40,
    // Les nombres que propose le bouton « Nombre » du panneau de l'arène (touche U).
    nombres: [1, 3, 5, 10],
    // Les races d'ennemis (jalon Y) : (espèce de Veloren, nom affiché).
    races: [
        ("human", "Humains"),
        ("orc", "Orcs"),
        ("dwarf", "Nains"),
        ("elf", "Elfes"),
        ("draugr", "Draugr"),
        ("danari", "Danari"),
    ],
    // Les rôles d'ennemis : (id, nom affiché) ; le fichier est assets/icebreaker/ennemis/<id>.ron.
    roles: [
        ("guerrier", "Guerrier"),
        ("archer", "Archer"),
        ("mage", "Mage"),
        ("chef", "Chef"),
    ],
    // Les alliés (Q53) : (id, nom affiché, fichier d'entité de Veloren). Ils sont du camp de celui qui les appelle.
    allies: [
        ("garde", "Garde", "common.entity.village.guard"),
        ("capitaine", "Capitaine", "common.entity.village.captain"),
        ("archer", "Archer", "common.entity.village.bowman"),
        ("loup", "Loup", "common.entity.wild.aggressive.wolf"),
    ],
    // Le premier mannequin de la rangée (`entrainement.ron` : ils s'alignent vers l'est), depuis le centre de l'arène.
    mannequins: (-6.0, 34.0),
    // Secondes avant qu'un joueur mort réapparaisse à l'entrée.
    delai_reapparition: 4.0,
)
