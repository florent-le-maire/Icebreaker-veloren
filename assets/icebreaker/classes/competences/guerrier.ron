// Icebreaker : compétences de départ du guerrier (classes.ron).
// Format des préréglages de compétences de Veloren (assets/common/skillset/preset/).
// Trois postures : riposte (défensive), balayage lourd (lourde), tranche-tourbillon (tranchante), sur les touches 1 à
// 3 (`touches` de classes.ron) ; taillade en croissant et cascade sont leurs prérequis (touches 4 et 5).
[
    Group(Weapon(Sword)),
    Skill((Sword(CrescentSlash), 1)),
    Skill((Sword(Cascade), 1)),
    Skill((Sword(DefensiveRiposte), 1)),
    Skill((Sword(HeavySweep), 1)),
    Skill((Sword(CleavingWhirlwindSlice), 1)),
]
