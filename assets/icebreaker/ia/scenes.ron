// Icebreaker IA : les scènes d'essai du lieu d'entraînement (`/entrainement scene <nom>`,
// docs/icebreaker/PLAN-IA.md). Une scène nettoie l'arène, fait venir ses groupes et pose le joueur.
//   texte   : ce qu'on y essaie (dit au joueur)
//   joueur  : où il est posé, depuis le centre de l'arène (x vers l'est, y vers le nord) ; absent : il ne bouge pas
//   groupes : race et role (ceux de arene.ron), nombre, en (depuis le centre), regard (vers où ils sont tournés),
//             immobile (ils ne flânent pas au repos)
// Le plateau fait 48 blocs de rayon ; un ennemi voit à 32 blocs devant lui (ia/profils.ron).
#![enable(implicit_some)]
(
    scenes: {
        // IA.3 : on est dans le dos de l'orc, trop loin pour qu'il nous sente.
        "ecoute": (
            texte: "un orc vous tourne le dos, à 18 blocs. /entrainement bruit : il vient voir (« ? »), puis vous voit (« ! »).",
            joueur: (0.0, -18.0),
            groupes: [
                (race: "orc", role: "guerrier", nombre: 1, en: (0.0, 0.0), regard: (0.0, 1.0), immobile: true),
            ],
        ),
        // IA.5, IA.7 : un guerrier en face, à 10 blocs. À essayer en /entrainement difficulte 1, 4 puis 6 : il
        // réagit plus vite, laisse moins de temps morts ; en 4 il pare parfois un coup armé, en 6 il pare ou roule
        // (avec /entrainement ia : « pare ! », « esquive ! »). Un coup rapide passe.
        "duel": (
            texte: "un guerrier en face. Essayez un coup lent puis un coup rapide, en difficulté 1, 4 et 6.",
            joueur: (0.0, -10.0),
            groupes: [
                (race: "orc", role: "guerrier", nombre: 1, en: (0.0, 0.0), regard: (0.0, -1.0), immobile: true),
            ],
        ),
        // IA.8 : un danari déjà blessé (sous son seuil de fuite), en face. Il fuit dès qu'il nous voit ; perdu de vue
        // 10 s, il se calme là où il est. Dans un donjon, acculé au fond d'une salle : « Pitié ! » (il se tapit ; le
        // frapper le fait détaler à travers nous) ou « Poussez-vous ! » (il force le passage).
        "fuyard": (
            texte: "un danari blessé, en face : il fuit. Rattrapez-le, acculez-le.",
            joueur: (0.0, -12.0),
            groupes: [
                (race: "danari", role: "guerrier", nombre: 1, en: (0.0, 0.0), regard: (0.0, -1.0), immobile: true, pv: 0.25),
            ],
        ),
        // IA.6 : un mage à 25 blocs, de face. Avec /entrainement ia il dit le sort qu'il choisit : de loin la boule
        // de feu ; approchez : le lance-flammes ; collez-le : l'onde de feu. En difficulté 6 il a tous ses sorts.
        "mage": (
            texte: "un mage à 25 blocs. /entrainement ia : il dit ses sorts. Approchez, collez-le, foncez-lui dessus.",
            joueur: (0.0, -25.0),
            groupes: [
                (race: "elf", role: "mage", nombre: 1, en: (0.0, 0.0), regard: (0.0, -1.0), immobile: true),
            ],
        ),
        // IA.4 : trois orcs au centre, un quatrième à l'écart, et un groupe loin au nord qui ne voit ni n'entend
        // le combat. On tue ceux du centre : celui de l'écart vient se battre, ou part chercher le groupe du nord
        // (« Je vais chercher les autres ! », puis « Des intrus ! ») ; le groupe vient voir là où on a été vu.
        "massacre": (
            texte: "trois orcs au centre, un à l'écart, quatre loin au nord. Tuez ceux du centre : celui de l'écart se bat, ou part chercher les autres.",
            joueur: (0.0, -12.0),
            groupes: [
                (race: "orc", role: "guerrier", nombre: 3, en: (0.0, 0.0), regard: (0.0, 1.0), immobile: true),
                (race: "orc", role: "guerrier", nombre: 1, en: (-8.0, 10.0), regard: (0.0, 1.0), immobile: true),
                (race: "orc", role: "guerrier", nombre: 4, en: (-10.0, 40.0), regard: (0.0, 1.0), immobile: true),
            ],
        ),
    },
)
