// Icebreaker U.16 : tout se casse à la pioche, dans une Grotte et dans un donjon généré ; c'est
// plus ou moins facile selon la matière (docs/icebreaker/design/destruction.md).
//   coups   : coups de pioche pour que le bloc cède ;
//   energie : énergie payée à chaque coup (sans elle, le coup ne fait rien).
// Les matières sont les genres de bloc de Veloren (Rock = roche et murs de pierre, Wood = bois).
(
    matieres: {
        "WeakRock": (coups: 1, energie: 5.0),
        "GlowingWeakRock": (coups: 1, energie: 5.0),
        "Earth": (coups: 2, energie: 8.0),
        "Sand": (coups: 2, energie: 8.0),
        "Grass": (coups: 2, energie: 8.0),
        "Wood": (coups: 3, energie: 10.0),
        "Rock": (coups: 3, energie: 15.0),
        "GlowingRock": (coups: 3, energie: 15.0),
    },
    // Toute autre matière pleine.
    defaut: (coups: 3, energie: 15.0),
    // U.17 : quand le bloc visé cède, c'est un éclat en cône qui part : il part du corps de qui creuse
    // (large comme lui) et se referme devant lui, vers le bloc visé ; on avance en piochant. Les blocs
    // plus durs que le bloc visé restent.
    //   largeur    : demi-largeur au corps de qui creuse, en blocs (0 : seul le bloc visé cède) ;
    //   hauteur    : demi-hauteur au corps (sous 1.5, le sol sous les pieds et la voûte restent) ;
    //   profondeur : distance de la pointe devant lui, en blocs.
    // 1.9 de large : un boyau de 3 blocs ; 2.9 : de 5 blocs. Un bloc visé à hauteur du corps : on
    // creuse à plat, droit devant ; plus haut ou plus bas, dans l'axe du bloc.
    cone: (largeur: 1.9, hauteur: 1.4, profondeur: 5.0),
)
