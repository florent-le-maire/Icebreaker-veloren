// Icebreaker : les classes des recrues de la charrette (jalon R, décision 0017).
// Une classe = un équipement de départ et ses compétences :
// - `equipement` est un fichier d'équipement de Veloren (armure et armes en main), sous `assets/` ; s'y ajoutent une
//   potion et du fromage, comme pour tout personnage, et une pioche de Veloren en mains secondaires (K.4), pour
//   les filons de la grotte ;
// - `competences` est un fichier de compétences de Veloren (`classes/competences/*.ron`) : les compétences de
//   l'arme débloquées au départ, qui se placent sur les premières touches
//   dans l'ordre de Veloren ;
// - `touches` (facultatif) : les compétences à mettre d'abord, dans cet ordre, sur les touches 1, 2, 3…
// - `icone` (facultatif) : l'icône de la classe dans l'interface (jalon N), parmi les icônes d'armes du
//   jeu : epees, epee, baton, arc, hache, marteau, sceptre.
(
    classes: [
        (id: "guerrier", nom: "guerrier", icone: "epees", equipement: "icebreaker.classes.guerrier",
            competences: "icebreaker.classes.competences.guerrier",
            touches: [Sword(DefensiveRiposte), Sword(HeavySweep), Sword(CleavingWhirlwindSlice)]),
        (id: "mage", nom: "mage", icone: "baton", equipement: "icebreaker.classes.mage",
            competences: "icebreaker.classes.competences.mage"),
        (id: "archer", nom: "archer", icone: "arc", equipement: "icebreaker.classes.archer",
            competences: "icebreaker.classes.competences.archer"),
    ],
)
