// Icebreaker Y.3 : les rondes de chaque race ennemie (common/src/icebreaker_races.rs, design/ames.md).
// Le reste du comportement d'une race (choix de cible, fuite…) est dans ia/profils.ron depuis le jalon IA ; les
// rondes y passeront avec IA.10.
//
// ronde : des rondes entre les salles du donjon généré : les guerriers éveillés d'une salle (membres au plus,
// groupes salles au plus, jamais celle du chef) vont de salle en salle (etapes, la leur comprise, sans clé ni
// chute), s'arrêtent pause secondes à chaque salle (atteinte à arrivee blocs du milieu), puis reviennent ;
// vitesse : allure (1 = la course).
#![enable(implicit_some)]
(
    races: {
        "danari": (),
        // Organisés.
        "human": (
            ronde: (
                groupes: 2,
                membres: 3,
                etapes: 3,
                vitesse: 0.5,
                pause: 5.0,
                arrivee: 3.0,
            ),
        ),
        "orc": (),
        "dwarf": (),
        "elf": (),
        "draugr": (),
    },
)
