                range: 6.0,
                angle: 5.0,
                multi_target: Some(Normal),
            ),
            buildup_duration: 0.15,
            swing_duration: 0.1,
            hit_timing: 0.5,
            recover_duration: 0.4,
            movement: (
                buildup: Some(Forward(2.0)),
                swing: Some(Forward(2.0)),
                recover: None,
            ),
        ),
    ],
    energy_cost_per_strike: 5,
)
