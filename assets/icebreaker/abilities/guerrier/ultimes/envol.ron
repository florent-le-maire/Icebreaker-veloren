// Icebreaker : Envol (ultime du guerrier, A.22, remplace Fureur) — sur le modèle de common.abilities.custom.gigas_fire.lava_leap : le guerrier s'élève, des ailes dans le dos, puis retombe ; l'atterrissage explose (rayon 8) et lance une onde tout autour, sur les ennemis seulement, et relève les alliés à terre à 10 m (`icebreaker_releve`).
LeapExplosionShockwave(
    energy_cost: 30.0,
    buildup_duration: 0.3,
    movement_duration: 0.9,
    swing_duration: 0.15,
    recover_duration: 0.5,
    forward_leap_strength: 12.0,
    vertical_leap_strength: 22.0,
    explosion_damage: 50,
    explosion_poise: 60,
    explosion_knockback: (direction: Away, strength: 12.0),
    explosion_radius: 8.0,
    min_falloff: 0.5,
    shockwave_damage: 20.0,
    shockwave_poise: 30.0,
    shockwave_knockback: (direction: Up, strength: 8.0),
    shockwave_angle: 360.0,
    shockwave_vertical_angle: 45.0,
    shockwave_speed: 20.0,
    shockwave_duration: 0.6,
    shockwave_dodgeable: Jump,
    shockwave_damage_kind: Crushing,
    shockwave_specifier: Ground,
    move_efficiency: 1.0,
    icebreaker_releve: Some(10.0),
)
