// Icebreaker : Fournaise (ultime du mage, A.21) — un laser, sur la base de common.abilities.staff.flamethrower : il charge 1,5 s (buildup), puis un rayon étroit de 60 m brûle 2,5 s (`icebreaker_duree`, touche tenue ou non) tout ce qui est sur sa ligne jusqu'au premier mur (damage 20 par touche, 3 touches par seconde) ; le mage tourne lentement et avance à peine pendant le tir.
BasicBeam(
    buildup_duration: 1.5,
    recover_duration: 0.4,
    beam_duration: 0.4,
    damage: 20,
    tick_rate: 3.0,
    range: 60,
    max_angle: 2.0,
    damage_effect: Some(Buff((
        kind: Burning,
        dur_secs: 10.0,
        strength: DamageFraction(1),
        chance: 0.5,
    ))),
    energy_regen: 0,
    energy_drain: 0,
    move_efficiency: 0.15,
    ori_rate: 0.05,
    specifier: PhoenixLaser,
    icebreaker_duree: Some(2.5),
)
