// Icebreaker : Trait lourd niveau 5 (jalon A) — copie de common.abilities.bow.heavy_nock : garde l'explosion du niveau 3 et ralentit les ennemis touchés (Crippled, 5 s, ralentissement 0,4).
BasicRanged(
    energy_cost: 10,
    buildup_duration: 0.3,
    recover_duration: 0.2,
    projectile: (
        kind: Explosive(
            radius: 4,
            min_falloff: 0.25,
            target: SolidOnlyEntityAttack,
            reagent: Some(Earth),
        ),
        attack: Some((
            damage: 15,
            knockback: Some(40),
            buff: Some((
                kind: Crippled,
                dur_secs: 5.0,
                strength: Value(0.4),
                chance: 1.0,
            )),
            damage_kind: Crushing,
        )),
    ),
    projectile_body: Object(Arrow),
    projectile_speed: 40.0,
    vertical_angle_offset: 0.2,
    movement_modifier: (
        buildup: Some(0.6),
        recover: Some(0.6),
    ),
)
