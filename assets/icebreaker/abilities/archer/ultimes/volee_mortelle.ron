// Icebreaker : Volée mortelle (ultime de l'archer, A.23) — sur la base de common.abilities.bow.death_volley : l'archer tire vers le ciel ; tant que la touche est tenue, un cercle de 6 m suit le point visé (30 m au plus) ; au relâchement, douze salves de vingt-quatre flèches perforantes y tombent, une toutes les 0,3 s (A.25) (`icebreaker_pluie`, réglages : common/src/icebreaker_pluie.rs).
BasicRanged(
    energy_cost: 30,
    buildup_duration: 0.3,
    recover_duration: 0.6,
    projectile: (
        kind: Simple,
        attack: Some((
            damage: 8,
            without_combo: true,
            damage_kind: Piercing,
        )),
    ),
    projectile_body: Object(Arrow),
    projectile_speed: 45.0,
    movement_modifier: (
        buildup: Some(0.0),
        recover: Some(0.2),
    ),
    icebreaker_pluie: Some((
        delai: 0.3,
        salves: 12,
        intervalle: 0.3,
        par_salve: 24,
        rayon: 6.0,
        hauteur: 14.0,
        portee: 30.0,
    )),
)
